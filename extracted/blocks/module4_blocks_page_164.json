        39.172698974609375,
        801.0170288085938,
        136.43409729003906,
        811.52099609375
      ],
      "text": "150 WHO consolidated",
      "font": "SegoeUI-Light",
      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        136.43649291992188,
        801.0170288085938,
        170.0604705810547,
        811.52099609375
      ],
      "text": "guidelines",
      "font": "SegoeUI-Light",
      "size": 8.0,
      "type": "heading"
    },
    {
