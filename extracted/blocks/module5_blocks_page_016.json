      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        70.86609649658203,
        246.49652099609375,
        527.3352661132812,
        261.0495300292969
      ],
      "text": "Previously treated:  People who have previously received 1 month or more of TB medicines. Previously",
