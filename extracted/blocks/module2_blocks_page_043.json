        70.86609649658203,
        701.7929077148438,
        527.4187622070312,
        716.2359008789062
      ],
      "text": "from 8 studies conducted in Benin, Botswana, Brazil, Guinea, India, Kenya, Malawi, Myanmar, Peru,",
      "font": "SegoeUI-Light",
      "size": 11.0,
