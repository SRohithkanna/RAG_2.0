    },
    {
      "bbox": [
        90.70870208740234,
        437.3824157714844,
        491.095703125,
        451.825439453125
      ],
      "text": "containing regimens and other medicines, particularly ART, in both adults and children.",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        451.3824157714844,
        78.23609924316406,
        465.825439453125
      ],
      "text": "•",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        90.70870208740234,
        451.3824157714844,
        527.4053955078125,
        465.825439453125
      ],
      "text": "Studies should be undertaken to assess the durability of protection of different preventive",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.70870208740234,
        465.3824157714844,
        527.4230346679688,
        479.825439453125
      ],
      "text": "treatment regimens including long-acting injectables, in settings in which TB is endemic,",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.70870208740234,
        479.3824157714844,
        527.424072265625,
        493.825439453125
      ],
      "text": "and should include the efficacy of repeated courses of preventive treatment. Studies of the",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.70870208740234,
        493.3824157714844,
        504.3869323730469,
        507.825439453125
      ],
      "text": "preferences of different stakeholders for different regimen characteristics would be helpful.",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
