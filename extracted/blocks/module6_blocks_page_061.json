      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        90.70870208740234,
        339.3824157714844,
        527.4340209960938,
        353.825439453125
      ],
      "text": "Research to find shorter, better-tolerated TPT regimens than those currently recommended",
