      "type": "heading"
    },
    {
      "bbox": [
        90.70870208740234,
        633.3823852539062,
        527.418701171875,
        647.8253784179688
      ],
      "text": "Prospective randomized studies should be undertaken to determine the incremental benefits",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
