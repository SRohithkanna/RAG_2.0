    },
    {
      "bbox": [
        90.70870208740234,
        591.3823852539062,
        527.3878784179688,
        605.8253784179688
      ],
      "text": "MDR-TB should be evaluated under operational conditions. Further evidence on the risk of",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
