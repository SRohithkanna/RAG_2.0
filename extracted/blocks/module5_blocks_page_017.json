        78.23609924316406,
        115.49463653564453,
        527.0864868164062,
        129.93763732910156
      ],
      "text": "signs of pneumonia with a general danger sign (inability to breastfeed or drink, persistent vomiting,",
      "font": "SegoeUI-Light",
      "size": 10.975873947143555,
