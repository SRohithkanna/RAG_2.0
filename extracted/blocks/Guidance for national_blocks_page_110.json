        175.84739685058594,
        117.11641693115234,
        434.45550537109375,
        137.34361267089844
      ],
      "text": "ummary of evidence and",
      "font": "FrutigerLTStd-Black-SC70",
      "size": 16.799999237060547,
      "type": "heading_main"
    },
    {
      "bbox": [
        158.5753936767578,
