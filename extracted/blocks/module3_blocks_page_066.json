{
  "file": "module3",
  "page": 66,
  "blocks": [
    {
      "bbox": [
        70.86609649658203,
        68.93421936035156,
        421.1585388183594,
        85.31422424316406
      ],
      "text": "2.3.1 Concurrent use of tests in people living with HIV",
      "font": "FrutigerNeueLT-Md",
      "size": 14.0,
      "type": "heading"
    },
    {
      "bbox": [
        492.2799987792969,
        75.15564727783203,
        515.6900024414062,
        86.85564422607422
      ],
      "text": "NEW",
      "font": "FrutigerNeueLT-Md",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        97.07283020019531,
        192.72633361816406,
        113.45283508300781
      ],
      "text": "Recommendations",
      "font": "FrutigerNeueLT-Md",
      "size": 14.0,
      "type": "heading"
    },
    {
      "bbox": [
        85.41439819335938,
        135.70582580566406,
        512.604248046875,
        148.6198272705078
      ],
      "text": "7.\t For adults and adolescents with HIV who have signs or symptoms of TB, screen",
      "font": "FrutigerNeueLT-Bd",
      "size": 10.989595413208008,
      "type": "paragraph"
    },
    {
      "bbox": [
        105.25689697265625,
        151.20582580566406,
        512.2371215820312,
        164.1198272705078
      ],
      "text": "positive for TB, are seriously ill or have advanced HIV disease, concurrent testing",
      "font": "FrutigerNeueLT-Bd",
      "size": 10.949685096740723,
      "type": "paragraph"
    },
    {
      "bbox": [
        105.25689697265625,
        166.70582580566406,
        512.6253662109375,
        179.6198272705078
      ],
      "text": "using low-complexity automated NAATs on respiratory samples and LF-LAM on",
      "font": "FrutigerNeueLT-Bd",
      "size": 10.9606294631958,
      "type": "paragraph"
    },
    {
      "bbox": [
        105.25689697265625,
        182.20582580566406,
        512.5304565429688,
        195.1198272705078
      ],
      "text": "urine should be used as the initial diagnostic strategy for diagnosing TB rather",
      "font": "FrutigerNeueLT-Bd",
      "size": 10.99804973602295,
      "type": "paragraph"
    },
    {
      "bbox": [
        105.25689697265625,
        197.70582580566406,
        469.6611022949219,
        210.6198272705078
      ],
      "text": "than low-complexity automated NAATs on respiratory samples alone.",
      "font": "FrutigerNeueLT-Bd",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        105.25689697265625,
        216.07354736328125,
        356.3398132324219,
        228.9545440673828
      ],
      "text": "(Strong recommendation, low certainty of evidence)",
      "font": "FrutigerNeueLT-LtIt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        251.3863525390625,
        120.02171325683594,
        265.4743347167969
      ],
      "text": "Remarks",
      "font": "FrutigerNeueLT-Bd",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        70.86609649658203,
        276.17718505859375,
        78.81909942626953,
        289.32220458984375
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        276.17718505859375,
        526.96630859375,
        289.32220458984375
      ],
      "text": "Serious illness in people living with HIV is defined based on any of the following symptoms:",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        291.67718505859375,
        526.9598999023438,
        304.82220458984375
      ],
      "text": "respiratory rate ≥30 breaths per minute, temperature ≥39 °C, heart rate ≥120 beats per",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        307.17718505859375,
        254.65719604492188,
        320.32220458984375
      ],
      "text": "minute or unable to walk unaided.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        322.6772155761719,
        78.81909942626953,
        335.8222351074219
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        322.6772155761719,
        526.759521484375,
        335.8222351074219
      ],
      "text": "Advanced HIV disease is defined in people living with HIV who have a CD4 cell count of",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        338.1578063964844,
        449.2952880859375,
        351.3222351074219
      ],
      "text": "3 <200 cells/mm  or presenting with a WHO Stage 3/4 AIDS-defining illness.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        353.6772155761719,
        78.81909942626953,
        366.8222351074219
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        353.6772155761719,
        526.92041015625,
        366.8222351074219
      ],
      "text": "This concurrent testing recommendation supersedes prior guidance on using LF-LAM for",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        369.1772155761719,
        524.4105224609375,
        382.3222351074219
      ],
      "text": "people living with HIV and the use of a single molecular test for diagnosis of TB in this group.",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.968404769897461,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        384.6772155761719,
        78.81909942626953,
        397.8222351074219
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        384.6772155761719,
        526.962890625,
        397.8222351074219
      ],
      "text": "This recommendation is strong despite the low certainty of evidence because the findings",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        400.1772155761719,
        527.248779296875,
        413.3222351074219
      ],
      "text": "indicate large desirable effects (i.e. rapid and accurate diagnosis of TB in a highly vulnerable",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.989544868469238,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        415.6772155761719,
        527.2996826171875,
        428.8222351074219
      ],
      "text": "population – people living with HIV – in whom diagnosing TB is often challenging) over small",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.957769393920898,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        431.1772155761719,
        432.5895690917969,
        444.3222351074219
      ],
      "text": "undesirable effects (i.e. negative consequences of this testing strategy).",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        446.6772155761719,
        78.81909942626953,
        459.8222351074219
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        446.6772155761719,
        527.251708984375,
        459.8222351074219
      ],
      "text": "The LC-aNAAT products for which eligible data met the class-based performance criteria for",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.98098373413086,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        462.1772155761719,
        526.7031860351562,
        475.3222351074219
      ],
      "text": "this recommendation were Xpert MTB/RIF Ultra and Truenat MTB Plus. Data for performance",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.947274208068848,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        477.6772155761719,
        526.9422607421875,
        490.8222351074219
      ],
      "text": "of Truenat MTB Plus and MTB-RIF Dx were only available for testing among persons living",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        493.1772155761719,
        304.1451721191406,
        506.3222351074219
      ],
      "text": "with HIV without concurrent LF-LAM testing.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        521.5233764648438,
        239.91468811035156,
        537.9033813476562
      ],
      "text": "Justification and evidence",
      "font": "FrutigerNeueLT-Md",
      "size": 14.0,
      "type": "heading"
    },
    {
      "bbox": [
        70.86609649658203,
        548.1544189453125,
        527.2520141601562,
        561.2994384765625
      ],
      "text": "In a 2016 Cochrane systematic review of the diagnostic accuracy of LF-LAM, sensitivity increased",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.950638771057129,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        563.6544189453125,
        526.9701538085938,
        576.7994384765625
      ],
      "text": "by 13% when combining LF-LAM and sputum Xpert MTB/RIF, compared with sputum Xpert",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        579.1544189453125,
        526.8706665039062,
        592.2994384765625
      ],
      "text": "alone, while the specificity decreased by 4%. However, results were based on only a few studies,",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.953601837158203,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        594.6544189453125,
        406.4158020019531,
        607.7994384765625
      ],
      "text": "and analyses were restricted to participants able to produce sputum.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        620.166015625,
        279.74468994140625,
        636.5460205078125
      ],
      "text": "Incremental diagnostic accuracy",
      "font": "FrutigerNeueLT-Md",
      "size": 14.0,
      "type": "heading"
    },
    {
      "bbox": [
        70.86609649658203,
        646.796875,
        526.6443481445312,
        659.94189453125
      ],
      "text": "In 2023, WHO commissioned a series of systematic reviews to evaluate the incremental diagnostic",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.94486141204834,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        662.2775268554688,
        526.9728393554688,
        675.44189453125
      ],
      "text": "11 accuracy  of concurrent use of either two different tests – LC-aNAAT on respiratory samples and",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.94486141204834,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        677.796875,
        526.9921264648438,
        690.94189453125
      ],
      "text": "LF-LAM on urine among people living with HIV – or the same test on two samples (LC-aNAAT",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        693.296875,
        527.113037109375,
        706.44189453125
      ],
      "text": "on respiratory and stool samples) in children, or alternatively LC-aNAAT on respiratory and",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        708.7969360351562,
        403.533935546875,
        721.9419555664062
      ],
      "text": "stool samples along with LF-LAM on urine among children with HIV.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        760.1837768554688,
        467.8038330078125,
        772.9437866210938
      ],
      "text": "Incremental change in diagnostic accuracy with concurrent testing compared with individual sample 11\t testing.",
      "font": "FrutigerNeueLT-Lt",
      "size": 8.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        40.76240158081055,
        802.0169067382812,
        138.45811462402344,
        811.576904296875
      ],
      "text": "50 WHO consolidated",
      "font": "FrutigerNeueLT-Lt",
      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        138.4571075439453,
        802.0169067382812,
        177.0811309814453,
        811.576904296875
      ],
      "text": "guidelines",
      "font": "FrutigerNeueLT-Lt",
      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        177.0803985595703,
        802.0169067382812,
        288.38323974609375,
        811.576904296875
      ],
      "text": "on tuberculosis: Fourth edition",
      "font": "FrutigerNeueLT-Lt",
      "size": 8.0,
      "type": "heading"
    }
  ]
}