    },
    {
      "bbox": [
        136.10809326171875,
        546.1367797851562,
        408.1507568359375,
        555.2730712890625
      ],
      "text": "tuberculosis  to active TB more rapidly than any other known factor, with",
      "font": "TheSansSemiLight-Italic",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        136.01808166503906,
        558.2700805664062,
        408.2768859863281,
        567.2700805664062
      ],
      "text": "disease rates estimated at 35–162 per 1000 person-years of observation",
