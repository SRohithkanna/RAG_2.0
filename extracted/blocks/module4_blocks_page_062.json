      "type": "paragraph"
    },
    {
      "bbox": [
        83.86609649658203,
        522.2474975585938,
        515.947265625,
        537.9114990234375
      ],
      "text": "and linezolid be used in patients with pulmonary MDR/RR-TB and without fluoroquinolone",
      "font": "SegoeUI-LightItalic",
