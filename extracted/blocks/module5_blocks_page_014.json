      "bbox": [
        70.86609649658203,
        120.19074249267578,
        527.4202270507812,
        134.6337432861328
      ],
      "text": "of TB medicines for children and adolescents, and follow-up of children and adolescents with TB or",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        133.3907012939453,
        198.302978515625,
        147.8336944580078
      ],
      "text": "on TB preventive treatment.",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
