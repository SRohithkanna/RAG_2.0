    },
    {
      "bbox": [
        70.86609649658203,
        684.1060180664062,
        527.2744140625,
        698.5490112304688
      ],
      "text": "previously undiagnosed TB disease and TB infection among the contacts of an index TB patient in the",
      "font": "SegoeUI-Light",
      "size": 10.987592697143555,
