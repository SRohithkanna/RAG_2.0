      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        356.6383972167969,
        78.81909942626953,
        369.7834167480469
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        356.6383972167969,
        505.85931396484375,
        369.7834167480469
      ],
      "text": "Monitor patient loss to follow-up from a second test in a concurrent testing approach.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        372.1383972167969,
        78.81909942626953,
        385.2834167480469
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        372.1383972167969,
        524.3639526367188,
        385.2834167480469
      ],
      "text": "Monitor trends in the rate of indeterminate test results for both sample types with LC-aNAATs.",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.94486141204834,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        387.6383972167969,
        78.81909942626953,
        400.7834167480469
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        387.6383972167969,
        527.1286010742188,
        400.7834167480469
      ],
      "text": "Monitor trends in the discordance rate between the respiratory and stool LC-aNAAT results.",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.982786178588867,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        403.1383972167969,
        527.2482299804688,
        416.2834167480469
      ],
      "text": "If these differences vary from other local or regional patterns, or if the trends change, further",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.96584701538086,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        418.6383972167969,
        205.48770141601562,
        431.7834167480469
      ],
      "text": "investigation is required.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        446.9847412109375,
        191.30810546875,
        463.3647155761719
      ],
      "text": "Research priorities",
      "font": "FrutigerNeueLT-Md",
      "size": 14.0,
      "type": "heading"
    },
    {
      "bbox": [
        70.86609649658203,
        473.6156005859375,
        78.81909942626953,
        486.7606201171875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        473.6156005859375,
        526.9093017578125,
        486.7606201171875
      ],
      "text": "Evaluate the impact of concurrent specimen testing on patient-important outcomes for",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        489.1156005859375,
        446.6803283691406,
        502.2606201171875
      ],
      "text": "children (cure, mortality, time to diagnosis and time to start of treatment).",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        504.6156005859375,
        78.81909942626953,
        517.7606201171875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        504.6156005859375,
        526.96533203125,
        517.7606201171875
      ],
      "text": "Evaluate the impact of concurrent specimen testing on affordability and cost–effectiveness",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        520.1156005859375,
        236.34190368652344,
        533.2606201171875
      ],
      "text": "in the intended settings of use.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
