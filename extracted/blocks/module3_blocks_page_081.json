    {
      "bbox": [
        70.86609649658203,
        535.6156005859375,
        78.81909942626953,
        548.7606201171875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        535.6156005859375,
        478.50341796875,
        548.7606201171875
      ],
      "text": "Evaluate the performance of other LC-aNAATs in concurrent testing approaches.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        551.1156005859375,
        78.81909942626953,
        564.2606201171875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        551.1156005859375,
        526.9664306640625,
        564.2606201171875
      ],
      "text": "Identify an improved reference standard that accurately defines TB disease in children and",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        566.6156005859375,
        519.2461547851562,
        579.7606201171875
      ],
      "text": "paucibacillary specimens because the sensitivity of all available diagnostics is suboptimal.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        582.1156005859375,
        78.81909942626953,
        595.2606201171875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        582.1156005859375,
        526.7884521484375,
        595.2606201171875
      ],
      "text": "Develop new tools that correctly diagnose a higher proportion of TB in children. Ideally, the",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.993297576904297,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        597.6156005859375,
        517.8822631835938,
        610.7606201171875
      ],
      "text": "new tools will be rapid, affordable, feasible and acceptable to children and their parents.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        613.1156005859375,
        78.81909942626953,
        626.2606201171875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        613.1156005859375,
        526.634521484375,
        626.2606201171875
      ],
      "text": "Develop rapid point-of-care diagnostic tests and simpler alternative sample types for",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        628.6156005859375,
        326.34295654296875,
        641.7606201171875
      ],
      "text": "paucibacillary and extrapulmonary TB in children.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        644.1156005859375,
        78.81909942626953,
        657.2606201171875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        644.1156005859375,
        520.863037109375,
        657.2606201171875
      ],
      "text": "Perform operational research to ensure that tests are used optimally in intended settings.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        659.6156005859375,
        78.81909942626953,
        672.7606201171875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        659.6156005859375,
        526.9642944335938,
        672.7606201171875
      ],
      "text": "Develop and apply standardized methods for assessment of costs and cost–effectiveness,",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        675.1156005859375,
        373.30084228515625,
        688.2606201171875
      ],
      "text": "to improve comparability and scope of economic evidence.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
