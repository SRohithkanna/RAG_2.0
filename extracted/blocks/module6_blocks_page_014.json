      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        269.38238525390625,
        527.4111938476562,
        283.8254089355469
      ],
      "text": "access to high-quality promotive, preventive, curative, rehabilitative and palliative essential health",
