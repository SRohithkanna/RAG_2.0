      ],
      "text": "4. Recommendations",
      "font": "Helvetica-Condensed-Bold",
      "size": 22.0,
      "type": "heading_main"
    },
    {
      "bbox": [
        62.36220169067383,
        194.81900024414062,
        327.1652526855469,
        208.00799560546875
      ],
      "text": "Recommendations for management of newborn conditions",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        219.1575927734375,
        248.93983459472656,
        232.34658813476562
      ],
      "text": "4.1\t Vitamin K prophylaxis in newborns",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        235.78318786621094,
        399.1028137207031,
        249.273193359375
      ],
      "text": "a)\t All newborns should be given 1 mg of vitamin K intramuscularly (IM) after birth",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        248.78318786621094,
        399.13128662109375,
        262.273193359375
      ],
      "text": "(i.e. after the first hour by which the infant should be in skin-to-skin contact with",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        261.7831726074219,
        270.58154296875,
        275.273193359375
      ],
      "text": "the mother and breastfeeding should be initiated).",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        277.18780517578125,
        277.7628173828125,
        291.1078186035156
      ],
      "text": "(Strong recommendation, moderate quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        293.4524841308594,
        399.11279296875,
        306.9425048828125
      ],
      "text": "b)\tNeonates requiring surgical procedures, those with birth trauma, preterm",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        306.4524841308594,
        399.17144775390625,
        319.9425048828125
      ],
      "text": "newborns, and those exposed in utero to maternal medication known to interfere",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        319.4524841308594,
        399.1214599609375,
        332.9425048828125
      ],
      "text": "with vitamin K are at especially high risk of bleeding and must be given vitamin K",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        332.4524841308594,
        113.33148956298828,
        345.9425048828125
      ],
      "text": "(1 mg IM).",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        347.8570861816406,
        277.7628173828125,
        361.777099609375
      ],
      "text": "(Strong recommendation, moderate quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        374.6693115234375,
        390.27911376953125,
        387.8583068847656
      ],
      "text": "4.2\t Prophylactic antibiotics in newborns with risk factors for infection",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        391.29498291015625,
        399.0828552246094,
        404.7850036621094
      ],
      "text": "A neonate with risk factors for infection (i.e. membranes ruptured > 18 hours before",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        404.29498291015625,
        399.10284423828125,
        417.7850036621094
      ],
      "text": "delivery, mother had fever > 38 °C before delivery or during labour, or amniotic fluid",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        417.29498291015625,
        399.1028747558594,
        430.7850036621094
      ],
      "text": "was foul smelling or purulent) should be treated with the prophylactic antibiotics",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        430.29498291015625,
        399.0727844238281,
        443.7850036621094
      ],
      "text": "ampicillin (IM or intravenously, IV) and gentamicin for at least 2 days. After 2 days,",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        443.29498291015625,
        399.0629577636719,
        456.7850036621094
      ],
      "text": "the neonate should be reassessed and treatment continued only if there are signs of",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        456.29498291015625,
        196.23291015625,
        469.7850036621094
      ],
      "text": "sepsis (or a positive blood culture).",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        471.69970703125,
        269.5429382324219,
        485.6197204589844
      ],
      "text": "(Weak recommendation, very low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        498.51190185546875,
        283.0069274902344,
        511.7008972167969
      ],
      "text": "4.3\t Skin-to-skin contact in the first hour of life",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        515.137451171875,
        399.0628356933594,
        528.62744140625
      ],
      "text": "Newborns without complications should be kept in skin-to-skin contact with their",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        528.137451171875,
        399.12286376953125,
        541.62744140625
      ],
      "text": "mothers during the first hour after birth to prevent hypothermia and promote",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        541.137451171875,
        115.91290283203125,
        554.62744140625
      ],
      "text": "breastfeeding.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        556.5421752929688,
        252.91282653808594,
        570.462158203125
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        223.62339782714844,
        644.9403076171875,
        231.4174041748047,
        655.2992553710938
      ],
      "text": "13",
      "font": "Helvetica-Condensed-Ligh",
      "size": 9.0,
      "type": "paragraph"
    }
  ]
}