        85.04048919677734,
        618.5285034179688,
        213.58749389648438,
        632.156005859375
      ],
      "text": "Recommendation 18 n",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88939666748047,
        643.3121337890625,
        513.4508056640625,
        656.9396362304688
      ],
      "text": "Clinical evaluation of household and close contacts for active TB should be",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88939666748047,
        657.1121215820312,
        513.4853515625,
        670.7396240234375
      ],
      "text": "done on the basis of their risk for having or developing active TB or for",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88939666748047,
        670.912109375,
        513.4739379882812,
        684.5396118164062
      ],
      "text": "the potential consequences of the disease if it develops. Priority should be",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88939666748047,
        684.7120971679688,
        246.45541381835938,
        698.339599609375
      ],
      "text": "given to contacts who are:",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        103.03939819335938,
        704.64453125,
        356.85137939453125,
        718.864501953125
      ],
      "text": "children with symptoms suggestive of TB; -",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        103.03939819335938,
        719.0445556640625,
        259.3993835449219,
        733.2645263671875
      ],
      "text": "children <5 years of age; -",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        103.03939819335938,
        733.4445190429688,
        513.5594482421875,
        747.6644897460938
      ],
      "text": "children with known or suspected immunocompromising conditions  -",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        121.03939819335938,
        747.8445434570312,
        333.7513732910156,
        762.0645141601562
      ],
      "text": "(especially those living with HIV); and",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        85.74800109863281,
        785.518798828125,
        513.141357421875,
        797.518798828125
      ],
      "text": "The Global Advisory Committee on Vaccine Safety (GACVS) does not use the GRADE methodology for evaluating the  1",
      "font": "HelveticaNeue-Light",
      "size": 8.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        99.92520141601562,
        795.1187744140625,
        396.6212158203125,
        807.1187744140625
      ],
      "text": "quality of evidence; the BCG-related recommendations will therefore remain ungraded.",
      "font": "HelveticaNeue-Light",
      "size": 8.0,
      "type": "paragraph"
    },
    {
      "bbox": [
