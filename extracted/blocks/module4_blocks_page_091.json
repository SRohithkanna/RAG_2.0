    },
    {
      "bbox": [
        70.86609649658203,
        545.26953125,
        527.4200439453125,
        559.7125244140625
      ],
      "text": "deemed these outcomes critical or important for decision-making based on a prioritization survey",
      "font": "SegoeUI-Light",
