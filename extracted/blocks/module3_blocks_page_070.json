      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        707.1259765625,
        389.1407470703125,
        720.27099609375
      ],
      "text": "reducing diagnosis-associated costs (e.g. travel, missing work).",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
