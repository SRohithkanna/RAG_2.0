        632.4368896484375,
        492.8460388183594,
        645.5819091796875
      ],
      "text": "LC-aNAAT on respiratory and  345  1.77 29 (18–63)",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        147.90159606933594,
        645.4368896484375,
        275.46856689453125,
        658.5819091796875
      ],
      "text": "stool samples and LF-LAM",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        674.3644409179688,
        526.5020141601562,
        685.119384765625
      ],
      "text": "DALY: disability-adjusted life year; HIV: human immunodeficiency virus; ICER: incremental cost–effectiveness ratio;",
      "font": "FrutigerNeueLT-Lt",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        685.1644287109375,
        526.501953125,
        695.9193725585938
      ],
      "text": "LC-aNAAT: low-complexity automated nucleic acid amplification test; LF-LAM: lateral flow urine lipoarabinomannan",
      "font": "FrutigerNeueLT-Lt",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        695.9644775390625,
        186.0031280517578,
        706.7194213867188
      ],
      "text": "assay; UR: uncertainty range.",
