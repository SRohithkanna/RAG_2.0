      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        93.79071807861328,
        527.1683349609375,
        108.23371887207031
      ],
      "text": "propensity scores analysis included age, gender, baseline smear result, HIV status (including ART",
