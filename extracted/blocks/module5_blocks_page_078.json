      "type": "heading"
    },
    {
      "bbox": [
        78.04429626464844,
        353.2134094238281,
        206.7959747314453,
        367.6343994140625
      ],
      "text": "tuberculosis (MDR/RR-TB)",
      "font": "SegoeUI-SemiboldItalic",
