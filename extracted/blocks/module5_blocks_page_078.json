      "type": "heading"
    },
    {
      "bbox": [
        78.04429626464844,
        375.0039978027344,
        505.2800598144531,
        389.447021484375
      ],
      "text": "A shorter all-oral bedaquiline-containing regimen of 9–12 months duration is recommended",
      "font": "SegoeUI-Light",
