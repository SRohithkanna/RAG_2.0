    },
    {
      "bbox": [
        78.04429626464844,
        341.2134094238281,
        506.4205017089844,
        355.6343994140625
      ],
      "text": "Shorter all-oral bedaquiline-containing regimen for multidrug- or rifampicin-resistant",
