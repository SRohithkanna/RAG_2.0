      "type": "paragraph"
    },
    {
      "bbox": [
        78.04429626464844,
        303.5228271484375,
        485.468994140625,
        317.9658508300781
      ],
      "text": "recommended to add streptomycin or other injectable agents to the treatment regimen.",
      "font": "SegoeUI-Light",
      "size": 11.0,
