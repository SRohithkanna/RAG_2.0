      ],
      "text": "4. RECOMMENDATIONS",
      "font": "Helvetica-Condensed-Ligh",
      "size": 7.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        60.173309326171875,
        390.2569580078125,
        73.36231231689453
      ],
      "text": "4.6 \t Head or whole body cooling in management of hypoxic ischaemic",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        90.70870208740234,
        73.17330932617188,
        162.51669311523438,
        86.36231231689453
      ],
      "text": "encephalopathy",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        89.79890441894531,
        399.0827941894531,
        103.28890228271484
      ],
      "text": "Head or whole body cooling should not be done outside well-resourced, tertiary",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        102.79890441894531,
        399.14276123046875,
        116.28890228271484
      ],
      "text": "neonatal intensive care units, because there is potential for harm from this therapy",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        115.79890441894531,
        155.32289123535156,
        129.28890991210938
      ],
      "text": "in low-resource settings.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        131.20361328125,
        277.7628173828125,
        145.12362670898438
      ],
      "text": "(Strong recommendation, moderate quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        158.01580810546875,
        326.3909912109375,
        171.20480346679688
      ],
      "text": "4.7\t Antibiotics for treatment of necrotizing enterocolitis",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        174.6414031982422,
        399.0327453613281,
        188.13140869140625
      ],
      "text": "Young neonates with suspected necrotizing enterocolitis (NEC) should be treated",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        187.6414031982422,
        399.09283447265625,
        201.13140869140625
      ],
      "text": "with IV or IM ampicillin (or penicillin) and gentamicin as first line antibiotic",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        200.6414031982422,
        146.8129119873047,
        214.13140869140625
      ],
      "text": "treatment for 10 days.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        216.04608154296875,
        252.91282653808594,
        229.96609497070312
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        242.85830688476562,
        193.1259002685547,
        256.04730224609375
      ],
      "text": "4.8\t Kangaroo Mother Care",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        259.4839782714844,
        399.1029052734375,
        272.9739990234375
      ],
      "text": "Low birth weight (LBW) neonates weighing < 2000 g who are clinically stable should",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        272.4839782714844,
        351.68292236328125,
        285.9739990234375
      ],
      "text": "be provided Kangaroo Mother Care (KMC) early in the first week of life.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        287.8885803222656,
        277.7628173828125,
        301.80859375
      ],
      "text": "(Strong recommendation, moderate quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        314.7008056640625,
        388.4860534667969,
        327.8898010253906
      ],
      "text": "4.9\t Prevention of hypothermia immediately after birth in LBW infants",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        331.32647705078125,
        399.1230163574219,
        344.8164978027344
      ],
      "text": "LBW neonates weighing >1200g who do not have complications and are clinically",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        344.32647705078125,
        399.0328674316406,
        357.8164978027344
      ],
      "text": "stable should be put in skin-to-skin contact with the mother soon after birth and",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        357.32647705078125,
        313.9729309082031,
        370.8164978027344
      ],
      "text": "after drying them thoroughly to prevent neonatal hypothermia.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        372.7311096191406,
        249.51284790039062,
        386.651123046875
      ],
      "text": "(Weak recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        62.36220169067383,
        405.2126159667969,
        370.13134765625,
        418.401611328125
      ],
      "text": "Recommendations for treatment of cough and difficulty in breathing",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        429.55120849609375,
        314.32391357421875,
        442.7402038574219
      ],
      "text": "4.10\t Treatment of non-severe pneumonia with wheeze",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        446.1768798828125,
        396.7628173828125,
        459.6669006347656
      ],
      "text": "Antibiotics are not routinely recommended for children aged 2–59 months with non-",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        459.1768798828125,
        399.07281494140625,
        472.6669006347656
      ],
      "text": "severe pneumonia (i.e. fast breathing with no chest indrawing or danger sign) with",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        472.1768798828125,
        386.6129455566406,
        485.6669006347656
      ],
      "text": "a wheeze but no fever (< temperature 38 °C), as the cause is most likely to be viral.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        487.58148193359375,
        255.10281372070312,
        501.5014953613281
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        514.3936767578125,
        376.4849548339844,
        527.5827026367188
      ],
      "text": "4.11\t Antibiotic treatment for non-severe pneumonia with no wheeze",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        531.0194091796875,
        399.1128234863281,
        544.5093994140625
      ],
      "text": "a)\t Children with non-severe pneumonia (i.e. fast breathing with no chest indrawing",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        544.0194091796875,
        399.1114501953125,
        557.5093994140625
      ],
      "text": "or danger sign) should be treated with oral amoxicillin. The exception is in patients",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        557.0194091796875,
        108.82150268554688,
        570.5093994140625
      ],
      "text": "with HIV:",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        570.0194091796875,
        399.1113586425781,
        583.5093994140625
      ],
      "text": "—\t With low HIV prevalence, give amoxicillin at least 40mg/kg/dose twice daily",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        82.20469665527344,
        583.0194091796875,
        125.89469146728516,
        596.5093994140625
      ],
      "text": "for 3 days.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        223.61709594726562,
        644.9403076171875,
        231.42909240722656,
        655.2992553710938
      ],
      "text": "15",
      "font": "Helvetica-Condensed-Ligh",
      "size": 9.0,
      "type": "paragraph"
    }
  ]
}