    {
      "bbox": [
        70.86609649658203,
        590.345703125,
        527.5345458984375,
        604.7886962890625
      ],
      "text": "the lack of high-certainty evidence, the GDG considered that a strong recommendation for symptom",
      "font": "SegoeUI-Light",
