      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        480.94610595703125,
        577.1456909179688,
        527.4210815429688,
        591.5886840820312
      ],
      "text": "). Despite",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
