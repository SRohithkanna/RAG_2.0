    },
    {
      "bbox": [
        70.86609649658203,
        281.34259033203125,
        527.403564453125,
        295.7856140136719
      ],
      "text": "Disaggregation of data by sex will be important to evaluate the impact on gender equity. Evaluating",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
