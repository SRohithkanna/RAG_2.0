    {
      "bbox": [
        51.2847785949707,
        108.26406860351562,
        408.2059326171875,
        117.27597045898438
      ],
      "text": "Several molecular epidemiological studies have demonstrated reinfection with a new strain",
      "font": "TheSansSemiLight-Plain",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        51.0320930480957,
