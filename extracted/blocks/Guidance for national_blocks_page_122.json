        213.58639526367188,
        96.53961181640625
      ],
      "text": "Recommendation 19 n",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739776611328,
        107.71759033203125,
        513.4487915039062,
        121.3450927734375
      ],
      "text": "It is recommended that contact investigation be conducted for household",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739776611328,
        121.517578125,
        510.2289123535156,
        135.14508056640625
      ],
      "text": "and close contacts when the index case has any of the following character-",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739013671875,
        135.31756591796875,
        135.46690368652344,
        148.945068359375
      ],
      "text": "istics:",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        155.11212158203125,
        329.244384765625,
        168.85462951660156
      ],
      "text": "has sputum smear-positive pulmonary TB, -",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        168.912109375,
        352.00286865234375,
        182.6546173095703
      ],
      "text": "has MDR-TB or XDR_TB (proven or suspected), -",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        182.71209716796875,
        157.1584014892578,
        196.45460510253906
      ],
      "text": "is a PLHIV, -",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        196.5120849609375,
        235.84141540527344,
        210.2545928955078
      ],
      "text": "is a child <5 years of age -",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        215.590576171875,
        370.8283996582031,
        228.94207763671875
      ],
      "text": "(Strong recommendation, very low quality of evidence)",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.04190063476562,
        240.12005615234375,
        213.58889770507812,
        253.74755859375
      ],
      "text": "Recommendation 20 n",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        264.925537109375,
        513.4742431640625,
        278.55303955078125
      ],
      "text": "Contact investigation may be conducted for household and close contacts",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        278.72552490234375,
        513.3936767578125,
        292.35302734375
      ],
      "text": "of all other index cases with pulmonary TB, in addition to the index cases",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        292.5255126953125,
        269.9044494628906,
        306.15301513671875
      ],
      "text": "covered in recommendation 19",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        317.60699462890625,
        398.52032470703125,
        330.95849609375
      ],
      "text": "(Conditional recommendation, very low quality of evidence).",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.04190063476562,
        342.1365051269531,
        213.58889770507812,
        355.7640075683594
      ],
      "text": "Recommendation 21 n",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        366.9420166015625,
        513.4166259765625,
        380.56951904296875
      ],
      "text": "Children <5 years of age who are household or close contacts of people with",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        380.74200439453125,
        513.3707275390625,
        394.3695068359375
      ],
      "text": "TB and who, after an appropriate clinical evaluation, are found not to have",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        394.5419921875,
        510.2314453125,
        408.16949462890625
      ],
      "text": "active TB should be given 6 months of IPT (10 mg/kg per day, range 7-15 mg/",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        408.34197998046875,
        276.0799255371094,
        421.969482421875
      ],
      "text": "kg, maximum dose 300 mg/day)",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        433.4234924316406,
        354.87786865234375,
        446.7749938964844
      ],
      "text": "(Strong recommendation, high quality of evidence).",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.04190063476562,
        457.9530029296875,
        213.58889770507812,
        471.58050537109375
      ],
      "text": "Recommendation 22 n",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        482.7585144042969,
        513.4053344726562,
        496.3860168457031
      ],
      "text": "In settings of high HIV prevalence, it is recommended that all household and",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        496.5585021972656,
        456.8828430175781,
        510.1860046386719
      ],
      "text": "close contacts of people with TB be counselled and tested for HIV",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        521.6400146484375,
        374.025390625,
        534.9915161132812
      ],
      "text": "(Strong recommendation, very low quality of evidence).",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.04190063476562,
        546.1694946289062,
        213.58889770507812,
        559.7969970703125
      ],
      "text": "Recommendation 23 n",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        570.9750366210938,
        513.4052124023438,
        584.6025390625
      ],
      "text": "In settings of low HIV prevalence, all household and close contacts of people",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        584.7750244140625,
        513.462890625,
        598.4025268554688
      ],
      "text": "with TB who have symptoms compatible with active TB, may be offered",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        598.5750122070312,
        454.3528747558594,
        612.2025146484375
      ],
      "text": "counselling and testing for HIV as part of their clinical evaluation",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        623.6565551757812,
        398.52032470703125,
        637.008056640625
      ],
      "text": "(Conditional recommendation, very low quality of evidence).",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.04190063476562,
        648.18603515625,
        213.58889770507812,
        661.8135375976562
      ],
      "text": "Recommendation 24 n",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        672.9915161132812,
        513.3822631835938,
        686.6190185546875
      ],
      "text": "All household contacts of an index case who is a PLHIV should be counselled",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        686.7915649414062,
        201.93939208984375,
        700.4190673828125
      ],
      "text": "and tested for HIV",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        711.873046875,
        374.025390625,
        725.2245483398438
      ],
      "text": "(Strong recommendation, very low quality of evidence).",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
