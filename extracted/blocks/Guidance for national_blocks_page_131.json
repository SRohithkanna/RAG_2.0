        359.68310546875
      ],
      "text": "Table A2.1",
      "font": "FrutigerLTStd-Light",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        141.04339599609375,
        359.86309814453125,
        261.7033996582031,
        374.0830993652344
      ],
      "text": "for RR-TB or MDR-TB)",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
