      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        124.72440338134766,
        484.2265319824219,
        456.0225524902344,
        501.4635314941406
      ],
      "text": "Investigations relevant for suspected pulmonary TB and suspected",
      "font": "HelveticaNeue",
      "size": 11.0,
      "type": "paragraph"
    },
    {
