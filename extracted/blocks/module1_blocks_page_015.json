      "bbox": [
        70.86609649658203,
        326.69451904296875,
        188.82931518554688,
        341.1375427246094
      ],
      "text": "completion of treatment (",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
