    {
      "bbox": [
        56.692901611328125,
        577.1043090820312,
        399.09283447265625,
        590.5942993164062
      ],
      "text": "to the meeting participated in all aspects of the meeting. Those with academic",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
