      ],
      "text": "1.1\t Target audience",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        125.91542053222656,
        399.0628662109375,
        139.40542602539062
      ],
      "text": "These recommendations are intended primarily for use by policy makers, child health",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        138.91542053222656,
        399.1028137207031,
        152.40542602539062
      ],
      "text": "programme managers, health-care providers, and professional bodies or technical",
      "font": "MinionPro-Regular",
      "size": 10.0,
