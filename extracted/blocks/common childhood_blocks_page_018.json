      "bbox": [
        56.692901611328125,
        432.93109130859375,
        399.0627746582031,
        446.4211120605469
      ],
      "text": "Health. The WHO Collaborating Centre for International Child Health (CICH) in",
      "font": "MinionPro-Regular",
