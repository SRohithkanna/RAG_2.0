    {
      "bbox": [
        56.692901611328125,
        525.1043701171875,
        399.10284423828125,
        538.5943603515625
      ],
      "text": "and kept as a record. Declaration forms were reviewed and discussed by the WHO",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        538.1043701171875,
        399.03289794921875,
        551.5943603515625
      ],
      "text": "GSC before the meeting, and outcomes were approved by the Director of Department",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        551.1043701171875,
        399.0928955078125,
        564.5943603515625
      ],
      "text": "of Maternal, Newborn, Child and Adolescent Health. Participants who declared",
      "font": "MinionPro-Regular",
      "size": 10.0,
