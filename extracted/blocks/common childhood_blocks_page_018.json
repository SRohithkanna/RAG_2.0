    {
      "bbox": [
        63.54180145263672,
        249.7578887939453,
        399.07183837890625,
        263.2478942871094
      ],
      "text": "To provide evidence-based recommendations for the clinical management of",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
