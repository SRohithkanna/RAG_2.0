    {
      "bbox": [
        56.692901611328125,
        458.93109130859375,
        364.73291015625,
        472.4211120605469
      ],
      "text": "six months and participated in undertaking some of the systematic reviews.",
      "font": "MinionPro-Regular",
      "size": 10.0,
