    {
      "bbox": [
        56.692901611328125,
        482.47869873046875,
        246.7619171142578,
        495.6676940917969
      ],
      "text": "1.4\t Management of conflict of interest",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        499.1043701171875,
        399.08282470703125,
        512.5943603515625
      ],
      "text": "All participants completed and signed a declaration of interest form; decisions taken",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        512.1043701171875,
        399.16278076171875,
        525.5943603515625
      ],
      "text": "on verbal declarations by members of the GDG at the meeting were documented",
      "font": "MinionPro-Regular",
      "size": 10.0,
