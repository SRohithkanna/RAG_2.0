      "bbox": [
        56.692901611328125,
        564.1043701171875,
        399.10296630859375,
        577.5943603515625
      ],
      "text": "receiving research funding from non-commercial organizations for projects related",
      "font": "MinionPro-Regular",
      "size": 10.0,
