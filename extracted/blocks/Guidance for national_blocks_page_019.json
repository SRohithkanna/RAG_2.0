        32.93328857421875
      ],
      "text": "Second",
      "font": "FrutigerLTStd-LightCn",
      "size": 9.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        63.09400177001953,
        21.884788513183594,
        86.86299896240234,
        32.93328857421875
      ],
      "text": "edition",
      "font": "FrutigerLTStd-LightCn",
      "size": 9.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        82.81961059570312,
        192.87136840820312,
        97.03961181640625
      ],
      "text": "preventive therapy",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        106.28939819335938,
        105.5631103515625,
        513.4124755859375,
        118.91461181640625
      ],
      "text": "Treatment offered to contacts who are considered to be at risk of developing TB",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        121.55963134765625,
        513.4586181640625,
        134.9111328125
      ],
      "text": "disease following exposure to a possible source in order to reduce that risk. While",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        137.55615234375,
        513.3894653320312,
        150.90765380859375
      ],
      "text": "this treatment is called “preventive therapy” by convention, it is actually treatment",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        153.55267333984375,
        216.18338012695312,
        166.9041748046875
      ],
      "text": "for latent TB infection.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        178.21963500976562,
        400.6513671875,
        192.43963623046875
      ],
      "text": "reverse contact investigation (source case investigation)",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        106.28939819335938,
        200.963134765625,
        513.4354248046875,
        214.31463623046875
      ],
      "text": "Contact investigation undertaken among household members of TB-infected",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        216.95965576171875,
        513.4239501953125,
        230.3111572265625
      ],
      "text": "children, with the goal of identifying and, if necessary, treating the source case and",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        232.9561767578125,
        332.4598693847656,
        246.30767822265625
      ],
      "text": "identifying any others they may have infected.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        257.6195373535156,
        148.81939697265625,
        271.83953857421875
      ],
      "text": "source case",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        106.28939819335938,
        280.363037109375,
        513.4124755859375,
        293.71453857421875
      ],
      "text": "A person with infectious TB (usually sputum smear- or culture-positive) who",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        296.35955810546875,
        361.0259704589844,
        309.7110595703125
      ],
      "text": "transmits infection to one or more other individuals.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        321.0195007324219,
        321.307373046875,
        335.239501953125
      ],
      "text": "standard case definitions of TB in children",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        106.28939819335938,
        343.76300048828125,
        513.4584350585938,
        357.114501953125
      ],
      "text": "The case definition is determined by the: anatomical site of disease, history of",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        359.7594909667969,
        513.4699096679688,
        373.1109924316406
      ],
      "text": "previous treatment, drug resistance and HIV status. The classification used for",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        375.7559814453125,
        513.492919921875,
        389.10748291015625
      ],
      "text": "children for recording and reporting purposes are the same that are used for all age",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        391.7524719238281,
        349.36492919921875,
        405.1039733886719
      ],
      "text": "groups. The case definitions are listed in Annex 2.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        416.4195251464844,
        199.50738525390625,
        430.6395263671875
      ],
      "text": "treatment outcomes",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        106.28939819335938,
        439.16302490234375,
        513.435546875,
        452.5145263671875
      ],
      "text": "The categories of treatment outcome used for children for recording and reporting",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        455.1595153808594,
        513.4699096679688,
        468.5110168457031
      ],
      "text": "purposes are the same as those used for all age groups. These are listed and",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        471.156005859375,
        248.79739379882812,
        484.50750732421875
      ],
      "text": "discussed further in Annex 2.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        495.81951904296875,
        284.8393859863281,
        510.0395202636719
      ],
      "text": "tuberculosis (TB) disease (active TB)",
      "font": "FrutigerLTStd-Bold",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        106.28939819335938,
        518.4940795898438,
        513.4009399414062,
        531.91455078125
      ],
      "text": "Mycobacterium tuberculosis  Refers to illness that occurs in someone infected with",
      "font": "FrutigerLTStd-LightItali",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        534.5595092773438,
        513.3779296875,
        547.9110107421875
      ],
      "text": "and is characterized by clinical signs and symptoms, with or without laboratory or",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        550.5559692382812,
        216.827392578125,
        563.907470703125
      ],
      "text": "radiographic evidence.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        739.2846069335938,
        512.7744750976562,
        749.78759765625
      ],
      "text": "Note:  The terms “active” and “latent” are controversial and not universally accepted because they imply",
      "font": "FrutigerLTStd-LightItali",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        750.138671875,
        512.6845092773438,
        760.587646484375
      ],
      "text": "the existence of a clear distinction when in fact there is a continuum from infection to disease, particularly",
      "font": "FrutigerLTStd-Light",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        760.9386596679688,
        512.6845092773438,
        771.3876342773438
      ],
      "text": "in children. However, categorization is useful for purposes of appropriate management and is usually done",
      "font": "FrutigerLTStd-Light",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        771.7386474609375,
        512.7476196289062,
        782.1876220703125
      ],
      "text": "on the basis of the presence or absence of characteristic clinical signs and symptoms, laboratory data and",
      "font": "FrutigerLTStd-Light",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        106.28939819335938,
        783.7356567382812,
        185.8043975830078,
        794.1846313476562
      ],
      "text": "radiographic studies.",
      "font": "FrutigerLTStd-Light",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        10.333000183105469,
        805.8439331054688,
        40.31300354003906,
        835.8439331054688
      ],
      "text": "xviii",
      "font": "HelveticaNeue-Light",
      "size": 20.0,
      "type": "heading_main"
    }
  ]
}