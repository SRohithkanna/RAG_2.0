      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        371.43719482421875,
        527.4266357421875,
        385.8802185058594
      ],
      "text": "of Science, Global Index Medicus, Global Health and Cochrane Central databases were searched in",
      "font": "SegoeUI-Light",
      "size": 11.0,
