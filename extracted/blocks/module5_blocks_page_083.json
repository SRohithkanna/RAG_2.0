    },
    {
      "bbox": [
        70.86609649658203,
        687.3489990234375,
        527.4102172851562,
        701.7919921875
      ],
      "text": "is available, evidence for the specific impact on child and adolescent TB outcomes is limited. Some",
      "font": "SegoeUI-Light",
