      "bbox": [
        135.90512084960938,
        588.26318359375,
        408.06488037109375,
        597.26318359375
      ],
      "text": "to have active TB should be treated for presumed LTBI as per WHO",
      "font": "TheSansSemiLight-Plain",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        135.9411163330078,
        600.2601928710938,
        179.72610473632812,
        609.2601928710938
      ],
      "text": "guidelines.",
      "font": "TheSansSemiLight-Plain",
      "size": 9.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        135.9411163330078,
        618.2601928710938,
        318.5330505371094,
        627.2601928710938
      ],
      "text": "Strong recommendation, high-quality evidence",
