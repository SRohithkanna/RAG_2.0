        526.5012817382812,
        448.57830810546875
      ],
      "text": "automated nucleic acid amplification test; MRS: microbiological reference standard; TB: tuberculosis; TN: true",
      "font": "FrutigerNeueLT-Lt",
      "size": 9.0,
      "type": "paragraph"
    },
    {
