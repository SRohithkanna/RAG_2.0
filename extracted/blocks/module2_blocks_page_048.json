      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        612.5875244140625,
        527.3926391601562,
        627.030517578125
      ],
      "text": "not diagnosed in a timely manner. An essential minimum screening strategy for this group would be",
      "font": "SegoeUI-Light",
      "size": 11.0,
