      "bbox": [
        70.86609649658203,
        423.9796142578125,
        527.4277954101562,
        438.4226379394531
      ],
      "text": "arising from true-positive screening results and the possible risk of overtreatment from false-positive",
      "font": "SegoeUI-Light",
      "size": 11.0,
