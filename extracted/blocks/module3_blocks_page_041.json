  "blocks": [
    {
      "bbox": [
        70.86609649658203,
        68.93421936035156,
        186.8113250732422,
        85.31422424316406
      ],
      "text": "Recommendation",
      "font": "FrutigerNeueLT-Md",
      "size": 14.0,
      "type": "heading"
    },
    {
      "bbox": [
        85.41439819335938,
        107.56733703613281,
        513.1466064453125,
        120.48133850097656
      ],
      "text": "5.\t In people with signs and symptoms of pulmonary TB, moderate complexity",
      "font": "FrutigerNeueLT-Bd",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        105.25689697265625,
        123.06733703613281,
        513.5823974609375,
        135.98133850097656
      ],
      "text": "automated NAATs may be used on respiratory samples for the detection of",
      "font": "FrutigerNeueLT-Bd",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        105.25689697265625,
        138.5673370361328,
        513.3240966796875,
        151.48133850097656
      ],
      "text": "pulmonary TB, and of rifampicin and isoniazid rsesistance, rather than culture",
      "font": "FrutigerNeueLT-Bd",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        105.25689697265625,
        154.0673370361328,
        216.03793334960938,
        166.98133850097656
      ],
      "text": "and phenotypic DST.",
      "font": "FrutigerNeueLT-Bd",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        105.25689697265625,
        172.4349365234375,
        510.61663818359375,
        185.31593322753906
      ],
      "text": "(Conditional recommendation, moderate certainty of evidence for diagnostic accuracy)",
      "font": "FrutigerNeueLT-LtIt",
      "size": 10.952446937561035,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        219.47332763671875,
        420.749755859375,
        232.6183319091797
      ],
      "text": "There are several subgroups to be considered for this recommendation:",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        239.22528076171875,
        78.81909942626953,
        252.3702850341797
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        239.22528076171875,
        527.00830078125,
        252.3702850341797
      ],
      "text": "The recommendation is based on evidence of diagnostic accuracy in respiratory samples of",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        254.72528076171875,
        327.74029541015625,
        267.87030029296875
      ],
      "text": "adults with signs and symptoms of pulmonary TB.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        270.22528076171875,
        78.81909942626953,
        283.37030029296875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        270.22528076171875,
        527.3042602539062,
        283.37030029296875
      ],
      "text": "The recommendation applies to people living with HIV (studies included a varying proportion",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.94486141204834,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        285.72528076171875,
        526.9533081054688,
        298.87030029296875
      ],
      "text": "of such individuals); performance on smear-negative samples was reviewed but was only",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        301.22528076171875,
        526.9630126953125,
        314.37030029296875
      ],
      "text": "available for TB detection, not for rifampicin and isoniazid resistance, and data stratified by",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        316.72528076171875,
        229.84169006347656,
        329.87030029296875
      ],
      "text": "HIV status were not available.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        332.2253112792969,
        78.81909942626953,
        345.3703308105469
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        332.2253112792969,
        526.97509765625,
        345.3703308105469
      ],
      "text": "The recommendation applies to adolescents and children based on the generalization of",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        347.7253112792969,
        527.1844482421875,
        360.8703308105469
      ],
      "text": "data from adults; an increased rate of indeterminate results may be found with paucibacillary",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.94486141204834,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        363.2253112792969,
        192.3431854248047,
        376.3703308105469
      ],
      "text": "TB disease in children.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        378.7253112792969,
        78.81909942626953,
        391.8703308105469
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        378.7253112792969,
        526.63525390625,
        391.8703308105469
      ],
      "text": "The review did not consider extrapolation of the finding for use in people with extrapulmonary",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.94486141204834,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        394.2253112792969,
        526.87060546875,
        407.3703308105469
      ],
      "text": "TB and testing on non-sputum samples because data on diagnostic accuracy of technologies",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.961381912231445,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        409.7253112792969,
        327.3001708984375,
        422.8703308105469
      ],
      "text": "in the class for non-sputum samples were limited.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        438.071533203125,
        239.91468811035156,
        454.4515075683594
      ],
      "text": "Justification and evidence",
      "font": "FrutigerNeueLT-Md",
      "size": 14.0,
      "type": "heading"
    },
    {
      "bbox": [
        70.86609649658203,
        464.7025146484375,
        527.2117919921875,
        477.8475341796875
      ],
      "text": "The WHO Global TB Programme initiated an update of the current guidelines and commissioned",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.94486141204834,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        480.2025146484375,
        526.9479370117188,
        493.3475341796875
      ],
      "text": "a systematic review on the use of moderate complexity automated NAATs for detection of TB",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        495.7025146484375,
        478.57470703125,
        508.8475341796875
      ],
      "text": "and resistance to rifampicin and isoniazid in people with signs and symptoms of TB.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        518.2064208984375,
        527.1019897460938,
        531.3514404296875
      ],
      "text": "Three PICO questions were designed to form the basis for the evidence search, retrieval",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        532.2064208984375,
        133.0819091796875,
        545.3514404296875
      ],
      "text": "and analysis:",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        551.9583740234375,
        526.9862060546875,
        565.1033935546875
      ],
      "text": "1.\t Should moderate complexity automated NAATs be used on respiratory samples in people",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        567.4583740234375,
        526.8320922851562,
        580.6033935546875
      ],
      "text": "with signs and symptoms of pulmonary TB for detection of pulmonary TB, as compared",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        582.9583740234375,
        149.49879455566406,
        596.1033935546875
      ],
      "text": "with culture?",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        606.9622802734375,
        526.9862060546875,
        620.1072998046875
      ],
      "text": "2.\t Should moderate complexity automated NAATs be used on respiratory samples in people",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        622.4622802734375,
        526.6344604492188,
        635.6072998046875
      ],
      "text": "with signs and symptoms of pulmonary TB for detection of resistance to rifampicin, as",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        637.9622802734375,
        314.90277099609375,
        651.1072998046875
      ],
      "text": "compared with culture-based phenotypic DST?",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        661.9661865234375,
        526.9862060546875,
        675.1112060546875
      ],
      "text": "3.\t Should moderate complexity automated NAATs be used on respiratory samples in people",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        677.4661865234375,
        527.0303955078125,
        690.6112060546875
      ],
      "text": "with signs and symptoms of pulmonary TB for detection of resistance to isoniazid, as",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        692.9661865234375,
        314.90277099609375,
        706.1112060546875
      ],
      "text": "compared with culture-based phenotypic DST?",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        716.97021484375,
        526.95703125,
        730.115234375
      ],
      "text": "A comprehensive search of the following databases (PubMed, Embase, BIOSIS, Web of Science,",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.972064018249512,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        732.47021484375,
        527.0030517578125,
        745.615234375
      ],
      "text": "LILACS and Cochrane) for relevant citations was performed. The search was restricted to the",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        747.97021484375,
        526.623291015625,
        761.115234375
      ],
      "text": "period January 2009 to July 2020. Reference lists from included studies were also searched. No",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.987342834472656,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        763.47021484375,
        527.0138549804688,
        776.615234375
      ],
      "text": "language restriction was applied. Because there were few studies for the selected index tests,",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        353.2680969238281,
        802.0169067382812,
        554.5132446289062,
        811.576904296875
      ],
      "text": "2. Recommendations for diagnosis of TB disease 25",
      "font": "FrutigerNeueLT-Lt",
      "size": 8.0,
      "type": "heading"
    }
  ]
}