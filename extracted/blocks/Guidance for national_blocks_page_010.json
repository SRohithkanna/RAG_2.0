    {
      "bbox": [
        85.03939819335938,
        137.9017333984375,
        513.448974609375,
        151.25323486328125
      ],
      "text": "This document represents consensus guidance developed by the WHO Global TB",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        153.89825439453125,
        495.33660888671875,
        167.249755859375
      ],
      "text": "Programme with input from the Childhood TB subgroup of the Stop TB Partnership.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        178.40472412109375,
        513.4030151367188,
        191.7562255859375
      ],
      "text": "The Global TB Programme of the World Health Organization gratefully acknowledges",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        194.4012451171875,
        513.4146118164062,
        207.75274658203125
      ],
      "text": "the members – listed below - of the Guidelines Development Group (henceforth referred",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        210.39776611328125,
        166.83889770507812,
        223.749267578125
