    },
    {
      "bbox": [
        85.03939819335938,
        590.9212646484375,
        513.3800659179688,
        604.2727661132812
      ],
      "text": "The revision of this guidance, including the meeting of the Guidelines Development Group,",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
