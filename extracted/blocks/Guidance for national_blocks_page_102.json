        90.71119689941406,
        212.56671142578125,
        358.00115966796875,
        226.50669860839844
      ],
      "text": "Prevention of mother-to-child HIV transmission services",
      "font": "Arial-BoldMT",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        110.55120086669922,
        230.68670654296875,
        513.0011596679688,
        243.9967041015625
      ],
      "text": "Pregnant women living with HIV should be screened regularly using a symptom-based",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.70870208740234,
        233.94210815429688,
        107.10869598388672,
        241.94210815429688
      ],
      "text": "n",
      "font": "ZapfDingbatsITC",
      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        110.55120086669922,
        242.68670654296875,
        512.9910888671875,
        255.9967041015625
      ],
      "text": "screening algorithm at each of their encounters with health workers and based on the",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        110.55120086669922,
        254.68670654296875,
        513.0111083984375,
        267.9967041015625
      ],
      "text": "outcome of the screening should either be provided with IPT or be further investigated for",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        110.55120086669922,
        266.68670654296875,
        126.11119842529297,
        279.9967041015625
      ],
      "text": "TB.",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        110.55120086669922,
        284.68670654296875,
        513.0110473632812,
        297.9967041015625
      ],
      "text": "Facilitate implementation of the integrated patient monitoring system of HIV (pre-ART and",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.70870208740234,
        287.9421081542969,
        107.10869598388672,
        295.9421081542969
      ],
      "text": "n",
      "font": "ZapfDingbatsITC",
      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        110.55120086669922,
        296.68670654296875,
        513.0111694335938,
        309.9967041015625
      ],
      "text": "ART), PMTCT and TB care recommended by WHO, UNICEF and the Global Fund to Fight",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        110.55120086669922,
        308.68670654296875,
        379.5411376953125,
        321.9967041015625
      ],
      "text": "AIDS, Malaria and Tuberculosis with standardized indicators.",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        110.55120086669922,
        326.68670654296875,
        513.0011596679688,
        339.9967041015625
      ],
      "text": "Integrated management of childhood illnesses (IMCI) services strengthen TB prevention,",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.70870208740234,
        329.9421081542969,
        107.10869598388672,
        337.9421081542969
      ],
      "text": "n",
      "font": "ZapfDingbatsITC",
      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        110.55120086669922,
        338.68670654296875,
        429.03106689453125,
        351.9967041015625
      ],
      "text": "case-finding, diagnosis, and treatment for children less than 5 years old.",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.71119689941406,
        356.56671142578125,
        275.2211608886719,
        370.5067138671875
      ],
      "text": "Family planning and infertility services",
      "font": "Arial-BoldMT",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        110.55120086669922,
        374.68670654296875,
        512.9910888671875,
        387.9967041015625
      ],
      "text": "Include tuberculosis prevention, diagnosis and treatment services to family planning and",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.70870208740234,
        377.9421081542969,
        107.10869598388672,
        385.9421081542969
      ],
      "text": "n",
      "font": "ZapfDingbatsITC",
      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        110.55120086669922,
        386.68670654296875,
        189.45118713378906,
        399.9967041015625
      ],
      "text": "infertility services.",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        110.55120086669922,
        404.68670654296875,
        510.20111083984375,
        417.9967041015625
      ],
      "text": "Establish effective referral mechanisms with tuberculosis services if inclusion is not possible.",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.70870208740234,
        407.9421081542969,
        107.10869598388672,
        415.9421081542969
      ],
      "text": "n",
      "font": "ZapfDingbatsITC",
      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        90.71119689941406,
        422.56671142578125,
        292.8211669921875,
        436.5067138671875
      ],
      "text": "Tuberculosis and HIV programme services",
      "font": "Arial-BoldMT",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        110.55120086669922,
        440.68670654296875,
        432.4010925292969,
        453.9967041015625
      ],
      "text": "Improve the recording and reporting of tuberculosis data by sex and age.",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.70870208740234,
        443.9421081542969,
        107.10869598388672,
        451.9421081542969
      ],
      "text": "n",
      "font": "ZapfDingbatsITC",
      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        110.55120086669922,
        458.68670654296875,
        513.0010986328125,
        471.9967041015625
      ],
      "text": "Encourage the use of case-based electronic recording and reporting systems and mobile",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.70870208740234,
        461.9421081542969,
        107.10869598388672,
        469.9421081542969
      ],
      "text": "n",
      "font": "ZapfDingbatsITC",
      "size": 8.0,
      "type": "heading"
    },
    {
      "bbox": [
        110.55120086669922,
        470.68670654296875,
        372.901123046875,
        483.9967041015625
      ],
      "text": "phones and other e-health communications and processes.",
      "font": "ArialMT",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        90.0531005859375,
        487.042724609375,
        195.7491455078125,
        499.042724609375
      ],
      "text": "Reproduced from reference 11",
      "font": "HelveticaNeue-Light",
      "size": 8.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        195.7491455078125,
        487.042724609375,
        317.6771545410156,
        499.042724609375
      ],
      "text": "by kind permission of the publisher",
      "font": "HelveticaNeue-Light",
      "size": 8.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        487.042724609375,
        319.16510009765625,
        499.042724609375
      ],
      "text": ". a",
      "font": "HelveticaNeue-Light",
      "size": 8.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        517.3307495117188,
        351.7513732910156,
        534.0587768554688
      ],
      "text": "Patient and family support for children with TB",
      "font": "Arial-BoldItalicMT",
      "size": 12.0,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        541.0702514648438,
        513.3569946289062,
        554.4217529296875
      ],
      "text": "When a child is diagnosed with TB, he or she should also be tested for HIV (if HIV status",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        557.0667114257812,
        513.4028930664062,
        570.418212890625
      ],
      "text": "is unknown). In many settings, the diagnosis of TB and/or of HIV can result in stigma",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        573.0631713867188,
        513.4489135742188,
        586.4146728515625
      ],
      "text": "and discrimination; the impact of this on the family unit adds to the burden of caring",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        589.0596923828125,
        398.5985107421875,
        602.4111938476562
      ],
      "text": "for children with TB or TB/HIV during physical illness and death.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        613.5662231445312,
        513.4375610351562,
        626.917724609375
      ],
      "text": "The model of family-centred care - an approach that focuses on the continuum of care",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        629.5626831054688,
        513.4030151367188,
        642.9141845703125
      ],
      "text": "for the whole family rather than the individual - requires a multidisciplinary approach",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        645.490234375,
        510.1829528808594,
        658.9107055664062
      ],
      "text": "(12) to address all the needs of the family. Basic principles of this continuum of care",
      "font": "FrutigerLTStd-LightItali",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        661.5557250976562,
        126.577392578125,
        674.9072265625
      ],
      "text": "include:",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        104.63939666748047,
        683.8779907226562,
        513.4215698242188,
        697.344482421875
      ],
      "text": "integration of care with prevention for the provision of a comprehensive, holistic  -",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        120.4894027709961,
        697.6780395507812,
        311.5504455566406,
        711.029541015625
      ],
      "text": "system of TB and TB/HIV management;",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        104.63939666748047,
        717.1473388671875,
        463.6379699707031,
        730.6138305664062
      ],
      "text": "provision of non-discriminatory/non-judgemental care and prevention; -",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        104.63939666748047,
        736.6166381835938,
        407.805419921875,
        750.0831298828125
      ],
      "text": "maintenance of confidentiality and respect for basic rights; -",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        104.63939666748047,
        756.0859375,
        513.3985595703125,
        769.5524291992188
      ],
      "text": "provision of clinical and nursing care and home-based care to alleviate symptoms  -",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        120.4894027709961,
        769.8859252929688,
        371.4195251464844,
        783.2374267578125
      ],
      "text": "of TB and HIV and prevent opportunistic infections;",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        104.63939666748047,
        789.355224609375,
        405.91943359375,
        802.8217163085938
      ],
      "text": "provision of counselling and psychosocial support services; -",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        558.6439208984375,
        805.8439331054688,
        580.8839111328125,
        835.8439331054688
      ],
      "text": "83",
      "font": "HelveticaNeue-Light",
      "size": 20.0,
      "type": "heading_main"
    }
