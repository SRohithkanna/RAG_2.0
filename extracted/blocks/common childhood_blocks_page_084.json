        340.4130554199219,
        35.34652328491211
      ],
      "text": "RECOMMENDATIONS FOR MANAGEMENT OF COMMON CHILDHOOD CONDITIONS",
      "font": "Helvetica-Condensed-Ligh",
      "size": 7.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        60.372276306152344,
        163.95286560058594,
        72.36227416992188
      ],
      "text": "10.1.2\t Benefits and risks",
      "font": "Helvetica-Condensed-Bold",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        76.01692962646484,
        88.77290344238281,
        88.15692901611328
      ],
      "text": "Benefits",
      "font": "Helvetica-Condensed-Obli",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        89.02693176269531,
        252.1428985595703,
        102.51692962646484
      ],
      "text": "As compared to clinical signs, pulse oximetry is:",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        63.54180145263672,
        107.69618225097656,
        252.22183227539062,
        121.1861801147461
      ],
      "text": "much more accurate at detecting hypoxaemia",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        109.9226303100586,
        63.541900634765625,
        118.9226303100586
      ],
      "text": "n",
      "font": "ZapfDingbats",
      "size": 9.0,
      "type": "heading"
    },
    {
      "bbox": [
        63.54180145263672,
        120.69618225097656,
        279.6618957519531,
        134.18618774414062
      ],
      "text": "requires less training than detection of clinical signs",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        122.9226303100586,
        63.541900634765625,
        131.92262268066406
      ],
      "text": "n",
      "font": "ZapfDingbats",
      "size": 9.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        139.36549377441406,
        272.3128967285156,
        152.85549926757812
      ],
      "text": "As compared to blood gas analysis, pulse oximetry is:",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        63.54180145263672,
        158.03480529785156,
        119.90180969238281,
        171.52481079101562
      ],
      "text": "non-invasive",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        160.26126098632812,
        63.541900634765625,
        169.26124572753906
      ],
      "text": "n",
      "font": "ZapfDingbats",
      "size": 9.0,
      "type": "heading"
    },
    {
      "bbox": [
        63.54180145263672,
        171.03480529785156,
        90.37179565429688,
        184.52481079101562
      ],
      "text": "faster",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        173.26126098632812,
        63.541900634765625,
        182.26124572753906
      ],
      "text": "n",
      "font": "ZapfDingbats",
      "size": 9.0,
      "type": "heading"
    },
    {
      "bbox": [
        63.54180145263672,
        184.03480529785156,
        124.12178802490234,
        197.52481079101562
      ],
      "text": "less expensive",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        186.26126098632812,
        63.541900634765625,
        195.26124572753906
      ],
      "text": "n",
      "font": "ZapfDingbats",
      "size": 9.0,
      "type": "heading"
    },
    {
      "bbox": [
        63.54180145263672,
        197.03480529785156,
        309.5718688964844,
        210.52481079101562
      ],
      "text": "requires minimal infrastructure and no laboratory facilities",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        199.26126098632812,
        63.541900634765625,
        208.26124572753906
      ],
      "text": "n",
      "font": "ZapfDingbats",
      "size": 9.0,
      "type": "heading"
    },
    {
      "bbox": [
        63.54180145263672,
        210.03480529785156,
        222.45187377929688,
        223.52481079101562
      ],
      "text": "less prone to erroneous measurements",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        212.26126098632812,
        63.541900634765625,
        221.26124572753906
      ],
      "text": "n",
      "font": "ZapfDingbats",
      "size": 9.0,
      "type": "heading"
    },
    {
      "bbox": [
        63.54180145263672,
        223.03480529785156,
        190.05178833007812,
        236.52481079101562
      ],
      "text": "allows continuous monitoring",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        225.26126098632812,
        63.541900634765625,
        234.26124572753906
      ],
      "text": "n",
      "font": "ZapfDingbats",
      "size": 9.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        244.52871704101562,
        78.65290069580078,
        256.668701171875
      ],
      "text": "Risks",
      "font": "Helvetica-Condensed-Obli",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        257.5386962890625,
        399.05279541015625,
        271.0287170410156
      ],
      "text": "Unlike blood gas analysis, pulse oximetry does not give an indication of ventilation",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        270.5386962890625,
        116.27118682861328,
        284.0287170410156
      ],
      "text": "(pCO ) or pH.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        79.4135971069336,
        277.82470703125,
        82.29359436035156,
        285.918701171875
      ],
      "text": "2",
      "font": "MinionPro-Regular",
      "size": 6.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        295.05731201171875,
        205.302978515625,
        307.04730224609375
      ],
      "text": "10.1.3\t Acceptability and feasibility",
      "font": "Helvetica-Condensed-Bold",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        310.71197509765625,
        399.0426330566406,
        324.2019958496094
      ],
      "text": "Given the large global burden of hypoxaemia, the mortality benefit in detecting",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        323.71197509765625,
        399.1126403808594,
        337.2019958496094
      ],
      "text": "and treating with oxygen, and the inaccuracy and unreliability of the detection",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        336.71197509765625,
        399.1428527832031,
        350.2019958496094
      ],
      "text": "and interpretation of clinical signs, the cost of pulse oximetry is justified. Blood gas",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        349.71197509765625,
        399.04296875,
        363.2019958496094
      ],
      "text": "analysis is expensive for most low-resource settings, given the high level of laboratory",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        362.71197509765625,
        399.0727844238281,
        376.2019958496094
      ],
      "text": "infrastructure required, as well as the cost and difficulty in obtaining and analysing",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        375.71197509765625,
        213.2929229736328,
        389.2019958496094
      ],
      "text": "an arterial sample in a timely manner.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        388.71197509765625,
        399.10150146484375,
        402.2019958496094
      ],
      "text": "Oximeters are becoming more affordable. Depending on the type and make, prices",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        401.71197509765625,
        399.14276123046875,
        415.2019958496094
      ],
      "text": "can range from US$ 35–400 (digit oximeters), US$ 60–1200 (hand-held oximeters)",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        414.71197509765625,
        399.0328674316406,
        428.2019958496094
      ],
      "text": "to US$ 800–4500 (oximeters with monitor displays, which can also be used in ICU",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        427.71197509765625,
        110.10291290283203,
        441.2019958496094
      ],
      "text": "and theatre).",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        440.71197509765625,
        399.0514221191406,
        454.2019958496094
      ],
      "text": "Several studies have shown the feasibility of implementing and sustaining oxygen",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        453.71197509765625,
        399.12298583984375,
        467.2019958496094
      ],
      "text": "systems, including pulse oximetry, in low-resource district and provincial hospitals",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        466.71197509765625,
        399.052734375,
        480.2019958496094
      ],
      "text": "in developing countries, including Malawi and Papua New Guinea [Duke, 2008;",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        479.71197509765625,
        120.00289916992188,
        493.2019958496094
      ],
      "text": "Enarson, 2009].",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        503.2594909667969,
        328.469970703125,
        516.448486328125
      ],
      "text": "10.2\t Clinical signs in detection of hypoxaemia in children",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        519.8851928710938,
        399.1227722167969,
        533.3751831054688
      ],
      "text": "a)\t Use pulse oximetry wherever possible is recommended for the detection of",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        532.8851928710938,
        399.0713806152344,
        546.3751831054688
      ],
      "text": "hypoxaemia in children with severe lower respiratory infections. If oximetry is",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        545.8851928710938,
        399.0814208984375,
        559.3751831054688
      ],
      "text": "not available then the following clinical signs could be used to guide the need for",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        558.8851928710938,
        132.67149353027344,
        572.3751831054688
      ],
      "text": "oxygen therapy:",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        571.8851928710938,
        147.23147583007812,
        585.3751831054688
      ],
      "text": "—\t central cyanosis",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        584.8851928710938,
        132.5814971923828,
        598.3751831054688
      ],
      "text": "—\t nasal flaring",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        597.8851928710938,
        348.261474609375,
        611.3751831054688
      ],
      "text": "—\t inability to drink or feed (where this is due to respiratory distress)",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        610.8851928710938,
        191.3915252685547,
        624.3751831054688
      ],
      "text": "—\t grunting with every breath",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        222.4586944580078,
        644.9403076171875,
        230.585693359375,
        655.2992553710938
      ],
      "text": "70",
      "font": "Helvetica-Condensed-Ligh",
      "size": 9.0,
      "type": "paragraph"
    }
  ]
}