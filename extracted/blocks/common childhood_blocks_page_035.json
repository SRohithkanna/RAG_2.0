    },
    {
      "bbox": [
        56.692901611328125,
        246.2397918701172,
        399.04296875,
        259.72979736328125
      ],
      "text": "a) \tResuscitation: Children severely dehydrated or with signs of shock should be",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        259.2397766113281,
        399.04156494140625,
        272.72979736328125
      ],
      "text": "resuscitated using isotonic intravenous (IV) solutions such as sodium chloride",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        272.2397766113281,
        160.2314910888672,
        285.72979736328125
      ],
      "text": "0.9% or ringers lactate.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        287.6445007324219,
        252.91282653808594,
        301.56451416015625
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        303.9090881347656,
        399.0628662109375,
        317.39910888671875
      ],
      "text": "b)\tIntravenous maintenance fluid: For children who require IV fluids for maintenance,",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        316.9090881347656,
        399.0614318847656,
        330.39910888671875
      ],
      "text": "options include ringers lactate solution with 5% dextrose, sodium chloride 0.45%",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        329.9090881347656,
        399.05145263671875,
        343.39910888671875
      ],
      "text": "with glucose 5%, sodium chloride 0.45% with glucose 2.5%, or 0.9% sodium",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        342.9090881347656,
        171.34149169921875,
        356.39910888671875
      ],
      "text": "chloride with glucose 5%.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        358.31378173828125,
        252.91282653808594,
        372.2337951660156
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        374.5783996582031,
        399.08282470703125,
        388.06842041015625
      ],
      "text": "c)\t Low sodium-containing solutions, such as sodium chloride 0.18% with glucose",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        387.5783996582031,
        399.0115051269531,
        401.06842041015625
      ],
      "text": "4%, or 5% glucose in water, should not be used as there is an increased risk of",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
