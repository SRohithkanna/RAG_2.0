      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86620330810547,
        242.7985382080078,
        527.424560546875,
        257.2415466308594
      ],
      "text": "molecular WHO-recommended rapid diagnostic in a close contact with clinical and/or radiological",
      "font": "SegoeUI-Light",
