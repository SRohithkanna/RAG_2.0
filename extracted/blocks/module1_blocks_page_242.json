      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86616516113281,
        290.9024658203125,
        527.4036254882812,
        305.3454895019531
      ],
      "text": "Secondary end-points included all forms of TB (bacteriologically confirmed or clinically probable),",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
