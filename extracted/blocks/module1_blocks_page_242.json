    {
      "bbox": [
        70.86620330810547,
        255.99855041503906,
        527.3941040039062,
        270.4415588378906
      ],
      "text": "evidence of TB disease. The primary outcome was assigned by an expert clinical panel that was",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86620330810547,
        269.198486328125,
        198.01992797851562,
        283.6415710449219
      ],
      "text": "allocation. blinded to group",
