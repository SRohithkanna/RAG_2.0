    },
    {
      "bbox": [
        85.03939819335938,
        292.8828125,
        513.403076171875,
        306.23431396484375
      ],
      "text": "At the global level, implementation and evaluation of this updated guidance may include",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
