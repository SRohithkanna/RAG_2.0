      "bbox": [
        104.87999725341797,
        333.38671875,
        513.417724609375,
        346.73822021484375
      ],
      "text": "WHO and partners providing training and monitoring tools for child TB and child",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
