    },
    {
      "bbox": [
        85.03939819335938,
        203.19503784179688,
        513.426025390625,
        216.61553955078125
      ],
      "text": "national tuberculosis programmes on the management of tuberculosis in children.  It",
      "font": "FrutigerLTStd-LightItali",
