      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        107.16522979736328,
        359.28192138671875,
        120.31022644042969
      ],
      "text": "Three web annexes give additional information, as follows:",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
