        86.86299896240234,
        32.93328857421875
      ],
      "text": "edition",
      "font": "FrutigerLTStd-LightCn",
      "size": 9.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        82.912109375,
        213.58639526367188,
        96.53961181640625
      ],
      "text": "Recommendation 16 n",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739776611328,
        107.71759033203125,
        513.4373168945312,
        121.3450927734375
      ],
      "text": "In children who are known to be HIV-infected, BCG vaccine should not be",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739776611328,
        121.517578125,
        132.92538452148438,
        135.14508056640625
      ],
      "text": "given",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        146.32305908203125,
        213.58639526367188,
        159.9505615234375
      ],
      "text": "Recommendation 17 n",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739776611328,
        171.1285400390625,
        513.414306640625,
        184.75604248046875
      ],
      "text": "In infants whose HIV status is unknown and who are born to HIV-positive",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739776611328,
        184.92852783203125,
        513.3797607421875,
        198.5560302734375
      ],
      "text": "mothers and who lack symptoms suggestive of HIV, BCG vaccine should be",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739776611328,
        198.728515625,
        296.5014343261719,
        212.35601806640625
      ],
      "text": "given after considering local factors",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        227.41249084472656,
        347.3853759765625,
        244.26849365234375
      ],
      "text": "Contact screening and management",
      "font": "FrutigerLTStd-Black",
      "size": 14.0,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        252.0159912109375,
        236.05740356445312,
        265.64349365234375
      ],
      "text": "Source of recommendations",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        271.0599670410156,
        513.4375,
        284.48046875
      ],
      "text": "Recommendations for investigating contacts of persons with infectious tuberculosis in",
      "font": "FrutigerLTStd-LightItali",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        287.0564880371094,
        510.2634582519531,
        300.47698974609375
      ],
      "text": "low- and middle-income countries.  Geneva, World Health Organization, 2012 (WHO/",
      "font": "FrutigerLTStd-LightItali",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        303.12200927734375,
        165.5854034423828,
        316.4735107421875
      ],
      "text": "HTM/TB/2012.9)",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        327.6285095214844,
        513.3914184570312,
        340.9800109863281
      ],
      "text": "The Panel considered the eight recommendations in this recent document that relate to",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        343.625,
        508.5040588378906,
        356.97650146484375
      ],
      "text": "children. All of these recent recommendations are consistent with the 2006 guidance.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        367.8554992675781,
        238.85191345214844,
        381.4830017089844
      ],
      "text": "Summary of recent evidence",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        386.968505859375,
        513.4835815429688,
        400.32000732421875
      ],
      "text": "There was no additional data to be considered that would change the quality of evidence",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        402.9649963378906,
        242.4513702392578,
        416.3164978027344
      ],
      "text": "or strength of recommendation.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        427.1971130371094,
        198.1304168701172,
        440.8246154785156
      ],
      "text": "Other considerations",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        446.31011962890625,
        513.41455078125,
        459.66162109375
      ],
      "text": "The 2006 guidance introduced a symptom-based screening approach for evaluating",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        462.3066101074219,
        513.41455078125,
        475.6581115722656
      ],
      "text": "child TB contacts. This is an approach that has since been adopted for implementing IPT",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        478.3031005859375,
        513.4373168945312,
        491.65460205078125
      ],
      "text": "in settings of high HIV prevalence and that has been evaluated in that context. However,",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        494.2995910644531,
        372.826904296875,
        507.6510925292969
      ],
      "text": "no prospective studies in children have yet been published.",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        518.5300903320312,
        161.72140502929688,
        532.1575927734375
      ],
      "text": "Panel decision",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        537.6431274414062,
        513.4605712890625,
        550.99462890625
      ],
      "text": "No changes were made to the recommendations but the wording was altered to",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        553.6395874023438,
        513.3800048828125,
        566.9910888671875
      ],
      "text": "be more specific for children for the purposes of this guidance. As noted above, the",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        569.6360473632812,
        513.4146118164062,
        582.987548828125
      ],
      "text": "recommended dosage for isoniazid in children, including for IPT, is 10 mg/kg with a",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        585.632568359375,
        407.3500061035156,
        598.9840698242188
      ],
      "text": "range of 7-15 mg/kg. The recommendations now read as follows:",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        612.6575927734375,
        213.58639526367188,
        626.2850952148438
      ],
      "text": "Recommendation 18 n",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739776611328,
        637.4630737304688,
        513.4488525390625,
        651.090576171875
      ],
      "text": "Clinical evaluation of household and close contacts for active TB should be",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739776611328,
        651.2630615234375,
        510.21734619140625,
        664.8905639648438
      ],
      "text": "done on the basis of risk for having or developing active TB or for the poten-",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88739776611328,
        665.0630493164062,
        503.5588073730469,
        678.6905517578125
      ],
      "text": "tial consequences of the disease if it develops. Priority should be given to:",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        684.8743286132812,
        329.0259094238281,
        698.6168212890625
      ],
      "text": "children with symptoms suggestive of TB, -",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        698.67431640625,
        235.6343994140625,
        712.4168090820312
      ],
      "text": "children <5 years of age, -",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        712.4743041992188,
        513.42822265625,
        726.216796875
      ],
      "text": "children with known or suspected immunocompromising conditions  -",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        103.03939819335938,
        726.2742919921875,
        320.1019287109375,
        739.9017944335938
      ],
      "text": "(especially children living with HIV), and",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        85.03939819335938,
        740.67431640625,
        509.17333984375,
        754.4168090820312
      ],
      "text": "child contacts of index cases with MDR-TB or XDR-TB (proven or suspected) -",
      "font": "FrutigerLTStd-Bold",
      "size": 11.5,
      "type": "heading"
    },
    {
      "bbox": [
        102.88990020751953,
        765.7557983398438,
        370.8283996582031,
        779.1072998046875
      ],
      "text": "(Strong recommendation, very low quality of evidence)",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        8.642800331115723,
        805.8439331054688,
        42.002803802490234,
        835.8439331054688
      ],
      "text": "102",
      "font": "HelveticaNeue-Light",
      "size": 20.0,
      "type": "heading_main"
    }
  ]
}