      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        147.18539428710938,
        590.3754272460938,
        482.3732604980469,
        603.5204467773438
      ],
      "text": "Testing  May require multiple specimen treatment steps before",
