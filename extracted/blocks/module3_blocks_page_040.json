    },
    {
      "bbox": [
        212.59840393066406,
        477.96002197265625,
        519.1573486328125,
        491.10504150390625
      ],
      "text": "automatically or manually to a disposable sealed container for",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        212.59840393066406,
        490.96002197265625,
        249.20640563964844,
        504.10504150390625
      ],
      "text": "testing.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        147.18539428710938,
        511.0985107421875,
        493.6208190917969,
        524.2435302734375
      ],
      "text": "Skills Moderate technical skills (i.e., multiple sample or reagent",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        212.59840393066406,
        524.0985107421875,
        470.0312805175781,
        537.2435302734375
      ],
      "text": "handling steps, precision pipetting may be required,",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        212.59840393066406,
        537.0985107421875,
        401.9413757324219,
        550.2435302734375
      ],
      "text": "molecular workflows may be required)",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        147.18539428710938,
        557.2369384765625,
