    },
    {
      "bbox": [
        70.86609649658203,
        356.9026184082031,
        527.4043579101562,
        371.34564208984375
      ],
      "text": "Frameworks for the surveillance of bacteriological status, drug resistance and assignment of outcomes",
      "font": "SegoeUI-Light",
      "size": 10.966950416564941,
