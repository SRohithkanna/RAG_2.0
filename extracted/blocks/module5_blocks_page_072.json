      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        440.3192138671875,
        271.66339111328125,
        457.5562438964844
      ],
      "text": "(91) years of age) with pulmonary MDR-TB  .",
      "font": "SegoeUI-LightItalic",
