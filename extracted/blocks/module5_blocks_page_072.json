      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        517.6170654296875,
        527.564208984375,
        532.06005859375
      ],
      "text": "recommended that delamanid may be added to the WHO-recommended longer regimen in children",
