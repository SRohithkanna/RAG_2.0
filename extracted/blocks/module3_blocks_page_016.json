    },
    {
      "bbox": [
        96.37799835205078,
        338.39251708984375,
        512.3098754882812,
        351.53753662109375
      ],
      "text": "samples to diagnose resistance to isoniazid, fluoroquinolones, bedaquiline, linezolid,",
