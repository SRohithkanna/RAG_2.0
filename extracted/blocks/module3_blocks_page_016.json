    },
    {
      "bbox": [
        96.37799835205078,
        240.49810791015625,
        507.81085205078125,
        253.6431121826172
      ],
      "text": "resistance to rifampicin, isoniazid, fluoroquinolones, pyrazinamide and ethambutol,",
