      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81920623779297,
        572.5201416015625,
        526.7568359375,
        585.6651611328125
      ],
      "text": "The recommendation was extrapolated to children based on the generalization of data from",
