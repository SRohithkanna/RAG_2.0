      "bbox": [
        70.86620330810547,
        619.0201416015625,
        78.81920623779297,
        632.1651611328125
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
