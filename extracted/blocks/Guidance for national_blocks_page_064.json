      "bbox": [
        104.63939666748047,
        643.0079345703125,
        305.6048889160156,
        656.4744262695312
      ],
      "text": "all children under 5 years of age; and, -",
      "font": "FrutigerLTStd-Light",
      "size": 11.5,
      "type": "paragraph"
    },
    {
      "bbox": [
        104.63939666748047,
        663.0770874023438,
        278.1083679199219,
        676.5435791015625
      ],
