      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        711.0463256835938,
        78.81909942626953,
        724.1913452148438
      ],
      "text": "•",
