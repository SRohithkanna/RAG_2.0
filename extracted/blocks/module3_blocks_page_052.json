    },
    {
      "bbox": [
        85.03929901123047,
        499.81719970703125,
        278.9009704589844,
        512.9622192382812
      ],
      "text": "technologies may be more appropriate.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        528.1213989257812,
        193.38153076171875,
        544.5574340820312
      ],
      "text": "Research priorities",
      "font": "FrutigerNeueLT-Bd",
      "size": 14.0,
