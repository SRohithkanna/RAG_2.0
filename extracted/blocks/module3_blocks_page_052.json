      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        587.0463256835938,
        78.81909942626953,
        600.1913452148438
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        587.0463256835938,
        527.12744140625,
        600.1913452148438
      ],
      "text": "diagnostic accuracy in specific patient populations (e.g. children, people living with HIV,",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        602.5463256835938,
        524.409912109375,
        615.6913452148438
      ],
      "text": "and patients with signs and symptoms of extrapulmonary TB) and in non-sputum samples;",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        618.0463256835938,
        78.81909942626953,
        631.1913452148438
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        618.0463256835938,
        527.2032470703125,
        631.1913452148438
      ],
      "text": "impact of diagnostic technologies on clinical decision-making and outcomes that are",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        633.5463256835938,
        527.0028076171875,
        646.6913452148438
      ],
      "text": "important to patients (e.g. cure, mortality, time to diagnosis and time to start treatment) in",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        649.0463256835938,
        198.80007934570312,
        662.1913452148438
      ],
      "text": "all patient populations;",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        664.5463256835938,
        78.81909942626953,
        677.6913452148438
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
