      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03939819335938,
        115.66120147705078,
        472.7066650390625,
        128.8061981201172
      ],
      "text": "no studies including any comparable data on systemic reactions were available.",
