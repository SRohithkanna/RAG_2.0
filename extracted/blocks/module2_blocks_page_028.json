    {
      "bbox": [
        70.86609649658203,
        698.87548828125,
        527.1736450195312,
        713.3184814453125
      ],
      "text": "interval [CI]: 3.3–4.0), with a median NNS of 35 (95% CI: 17–65). Systematic screening has been",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
