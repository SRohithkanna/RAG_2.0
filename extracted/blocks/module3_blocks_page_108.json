    },
    {
      "bbox": [
        78.81909942626953,
        188.565185546875,
        526.959228515625,
        201.71018981933594
      ],
      "text": "Gathering of more evidence on the impact of MTBDR  on appropriate MDR-TB treatment  sl",
      "font": "FrutigerNeueLT-Lt",
