      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.23609924316406,
        155.09474182128906,
        361.8345031738281,
        169.53773498535156
      ],
      "text": "No severe EPTB (any forms other than TB lymphadenopathy)",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        168.29469299316406,
        78.23609924316406,
        182.73768615722656
      ],
      "text": "•",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.23609924316406,
        168.29469299316406,
        527.5677490234375,
        182.73768615722656
      ],
      "text": "No resistance or suspected ineffectiveness of a medicine in the shorter regimen (except",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
