      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.23609924316406,
        141.8946075439453,
        192.93212890625,
        156.3376007080078
      ],
      "text": "No extensive TB disease",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        155.09474182128906,
