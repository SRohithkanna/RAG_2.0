        175.46388244628906,
        97.80619812011719
      ],
      "text": "retrieval and analysis.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        79.37000274658203,
