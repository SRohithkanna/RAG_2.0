      ],
      "text": "RECOMMENDATIONS FOR MANAGEMENT OF COMMON CHILDHOOD CONDITIONS",
      "font": "Helvetica-Condensed-Ligh",
      "size": 7.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        59.74208068847656,
        399.0915222167969,
        73.2320785522461
      ],
      "text": "—\t With high HIV prevalance, give amoxicillin of at least 40mg/kg/dose twice",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        82.20469665527344,
        72.74208068847656,
        146.03468322753906,
        86.2320785522461
      ],
      "text": "daily for 5 days.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        88.14679718017578,
        274.3729248046875,
        102.0667953491211
      ],
      "text": "(Weak recommendation, moderate quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        104.41151428222656,
        399.102783203125,
        117.9015121459961
      ],
      "text": "b)\tChildren with non-severe pneumonia who fail on the first line treatment with",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        117.41151428222656,
        399.11151123046875,
        130.90151977539062
      ],
      "text": "amoxicillin should have the option of referral to a facility where there is appropriate",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        130.41151428222656,
        158.06155395507812,
        143.90151977539062
      ],
      "text": "second line treatment.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        145.81597900390625,
        225.62290954589844,
        159.73599243164062
      ],
      "text": "(Weak recommendation, expert opinion)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        172.6282958984375,
        288.2099609375,
        185.81729125976562
      ],
      "text": "4.12\t Antibiotics treatment for severe pneumonia",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        189.25389099121094,
        399.09283447265625,
        202.743896484375
      ],
      "text": "a)\t Children aged 2–59 months with severe pneumonia (chest indrawing) should be",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        202.25389099121094,
        364.5815124511719,
        215.743896484375
      ],
      "text": "treated with oral amoxicillin at least 40mg/kg/dose twice daily for 5 days.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        217.65859985351562,
        277.7628173828125,
        231.57861328125
      ],
      "text": "(Strong recommendation, moderate quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        233.92320251464844,
        399.1028137207031,
        247.4132080078125
      ],
      "text": "b)\tIn HIV/AIDS infected children, specific guidelines for treatment of severe",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        246.92320251464844,
        283.9715881347656,
        260.4132080078125
      ],
      "text": "pneumonia in the context of HIV should be followed.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        262.327880859375,
        252.91282653808594,
        276.2478942871094
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        289.1401062011719,
        305.43597412109375,
        302.3291015625
      ],
      "text": "4.13\t Antibiotic treatment for very severe pneumonia",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        305.7657775878906,
        399.0628662109375,
        319.25579833984375
      ],
      "text": "a)\t Children aged 2–59 months with very severe pneumonia should be treated with",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        318.7657775878906,
        374.8714599609375,
        332.25579833984375
      ],
      "text": "parenteral ampicillin (or penicillin) and gentamicin as a first line treatment.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        331.7657775878906,
        399.09149169921875,
        345.25579833984375
      ],
      "text": "—\t Ampicillin: 50 mg/kg, or Benzyl penicillin: 50,000 units per kg IM/IV every",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        82.20469665527344,
        344.7657775878906,
        183.8847198486328,
        358.25579833984375
      ],
      "text": "6 hours for at least 5 days",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        357.7657775878906,
        320.19158935546875,
        371.25579833984375
      ],
      "text": "—\t Gentamicin: 7.5 mg/kg IM/IV once a day for at least 5 days",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        373.17041015625,
        277.7628173828125,
        387.0904235839844
      ],
      "text": "(Strong recommendation, moderate quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        389.43499755859375,
        399.0528564453125,
        402.9250183105469
      ],
      "text": "b)\tCeftriaxone should be used as a second line treatment in children with severe",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        402.43499755859375,
        272.0115661621094,
        415.9250183105469
      ],
      "text": "pneumonia with failure on the first line treatment.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        417.8396911621094,
        229.02288818359375,
        431.75970458984375
      ],
      "text": "(Strong recommendation, expert opinion)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        444.6518859863281,
        376.0449523925781,
        457.84088134765625
      ],
      "text": "4.14\t Inhaled salbutamol for treatment of acute wheeze/asthma and",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        90.70870208740234,
        457.6518859863281,
        181.3376922607422,
        470.84088134765625
      ],
      "text": "bronchoconstriction",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        474.277587890625,
        399.0828552246094,
        487.7676086425781
      ],
      "text": "a)\t Children with acute wheeze/asthma and bronchoconstriction should be treated",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        487.277587890625,
        399.04144287109375,
        500.7676086425781
      ],
      "text": "with inhaled salbutamol using a metered dose inhaler (MDI) with spacer devices",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        500.277587890625,
        194.79150390625,
        513.767578125
      ],
      "text": "to relieve bronchoconstriction.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        515.6821899414062,
        252.91282653808594,
        529.6021728515625
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        531.9468994140625,
        399.09295654296875,
        545.4368896484375
      ],
      "text": "b)\tOral salbutamol should not be used for treatment of acute or persistent wheeze",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        544.9468994140625,
        399.03125,
        558.4368896484375
      ],
      "text": "except where inhaled salbutamol is not available. Oral salbutamol is not useful in",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        557.9468994140625,
        213.07154846191406,
        571.4368896484375
      ],
      "text": "testing response to bronchodilators.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        573.3515014648438,
        252.91282653808594,
        587.271484375
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
