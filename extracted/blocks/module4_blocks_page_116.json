        556.9036865234375,
        518.8262329101562,
        571.2586669921875
      ],
      "text": "Regimens Bedaquiline Delamanid Linezolid Quinolone Clofazimine Pyrazinamide",
      "font": "SegoeUI-SemiBold",
      "size": 11.0,
      "type": "heading"
    },
