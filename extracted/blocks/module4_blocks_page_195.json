        81.86609649658203,
        696.5675048828125,
        524.4070434570312,
        707.0714721679688
      ],
      "text": "audio reminders or may send an SMS to remind the patient to take the medications, along with recording when the pill box is opened.",
      "font": "SegoeUI-Light",
