        510.7086181640625
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        497.5635986328125,
        151.18179321289062,
        510.7086181640625
      ],
