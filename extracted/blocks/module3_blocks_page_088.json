    },
    {
      "bbox": [
        70.86609649658203,
        387.08709716796875,
        78.81909942626953,
        400.23211669921875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        387.08709716796875,
        527.2637939453125,
        400.23211669921875
      ],
      "text": "The recommendations apply to people living with HIV (studies included a varying proportion",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.958271026611328,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        402.58709716796875,
        414.7927551269531,
        415.73211669921875
      ],
      "text": "of such individuals); data stratified by HIV status were not available.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        418.08709716796875,
        78.81909942626953,
        431.23211669921875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        418.08709716796875,
        526.9641723632812,
        431.23211669921875
      ],
      "text": "The recommendations are extrapolated to people with extrapulmonary TB, and testing of",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        433.58709716796875,
        527.1575927734375,
        446.73211669921875
      ],
      "text": "non-sputum samples was considered appropriate, which affects the certainty. The panel did",
      "font": "FrutigerNeueLT-Lt",
      "size": 10.974470138549805,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        449.08709716796875,
        527.0081787109375,
        462.23211669921875
      ],
      "text": "not evaluate test accuracy in non-sputum samples directly, including in children; however,",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        464.58709716796875,
        526.8197021484375,
        477.73211669921875
      ],
      "text": "extrapolation was considered appropriate given that WHO has recommendations for similar",
