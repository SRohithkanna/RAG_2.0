      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        356.08709716796875,
        78.81909942626953,
        369.23211669921875
      ],
      "text": "•",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        356.08709716796875,
        527.2062377929688,
        369.23211669921875
      ],
      "text": "The recommendations are extrapolated to adolescents and children, based on the",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        85.03929901123047,
        371.58709716796875,
        255.2729949951172,
        384.73211669921875
      ],
      "text": "generalization of data from adults.",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
