      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.81909942626953,
        325.08709716796875,
        526.7581176757812,
        338.23211669921875
      ],
      "text": "The recommendations are based on the evidence of diagnostic accuracy in sputum of adults",
