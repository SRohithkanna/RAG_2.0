        56.692901611328125,
        566.2539672851562,
        151.77340698242188,
        579.7439575195312
      ],
      "text": "as defined in  .",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
