      "bbox": [
        70.86609649658203,
        593.2835693359375,
        527.4256591796875,
        607.7265625
      ],
      "text": "found in the youngest age groups and the importance of rapid diagnosis and treatment owing to",
      "font": "SegoeUI-Light",
