      "bbox": [
        70.86609649658203,
        720.5875854492188,
        527.3925170898438,
        735.0305786132812
      ],
      "text": "offered counselling and testing for HIV. People living with HIV who are household contacts or close",
      "font": "SegoeUI-Light",
