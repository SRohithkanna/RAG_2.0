      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        70.86609649658203,
        376.6835021972656,
        78.23609924316406,
        391.12652587890625
      ],
      "text": "•",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        78.23609924316406,
        376.6835021972656,
        527.5588989257812,
        391.12652587890625
      ],
      "text": "Recurrence – two consecutive positive cultures separated by at least 14 days, or one positive culture",
      "font": "SegoeUI-Light",
      "size": 10.964693069458008,
      "type": "paragraph"
    },
    {
      "bbox": [
        82.86609649658203,
        389.8835144042969,
        527.406005859375,
        404.3265380859375
      ],
