      "bbox": [
        70.86609649658203,
        315.6372985839844,
        526.5169677734375,
        326.3923034667969
      ],
      "text": "DST: drug susceptibility testing; NGS: next-generation sequencing; pDST: phenotypic DST; TB: tuberculosis; tNGS:",
      "font": "FrutigerNeueLT-Lt",
      "size": 9.0,
      "type": "paragraph"
