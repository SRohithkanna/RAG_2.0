    },
    {
      "bbox": [
        78.23609924316406,
        242.0251007080078,
        527.4169921875,
        256.4681091308594
      ],
      "text": "The analysis was conducted according to a plan. Group assignment was blinded until analyses",
      "font": "SegoeUI-Light",
      "size": 11.0,
