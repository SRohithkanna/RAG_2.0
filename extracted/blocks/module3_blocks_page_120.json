        84.66120147705078,
        504.3922424316406,
        97.80619812011719
      ],
      "text": "pyrazinamide, using a composite reference standard of phenotypic DST and WGS;",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        87.86609649658203,
