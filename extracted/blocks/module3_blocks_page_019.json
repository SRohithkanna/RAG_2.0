    },
    {
      "bbox": [
        70.86609649658203,
        94.06519317626953,
        526.62890625,
        107.21018981933594
      ],
      "text": "Technologies will require a Pathway B review if they share characteristics with an existing",
      "font": "FrutigerNeueLT-Lt",
      "size": 11.0,
