    },
    {
      "bbox": [
        70.86609649658203,
        194.69459533691406,
        527.3992309570312,
        209.13758850097656
      ],
      "text": "50/75 mg (available from the Stop TB Partnership Global Drug Facility (GDF)). Capacity building of",
