    },
    {
      "bbox": [
        70.86609649658203,
        542.8836669921875,
        222.3613739013672,
        557.32666015625
      ],
      "text": "and safety of these interventions.",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
