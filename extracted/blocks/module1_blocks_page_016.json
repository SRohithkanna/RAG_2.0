        78.04435729980469,
        153.92298889160156,
        491.5787048339844,
        168.36598205566406
      ],
      "text": "6. Children aged ≥ 5 years, adolescents and adults who are household contacts of people",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        78.04432678222656,
        165.92298889160156,
        500.56329345703125,
        180.36598205566406
      ],
      "text": "with bacteriologically confirmed pulmonary TB who are found not to have TB disease on an",
      "font": "SegoeUI-Light",
      "size": 11.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        78.04432678222656,
        177.92298889160156,
        510.6494445800781,
        192.36598205566406
      ],
