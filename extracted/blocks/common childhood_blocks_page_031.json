        35.34652328491211
      ],
      "text": "4. RECOMMENDATIONS",
      "font": "Helvetica-Condensed-Ligh",
      "size": 7.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        62.36220169067383,
        64.42532348632812,
        268.3482360839844,
        77.61432647705078
      ],
      "text": "Recommendations for treatment of dysentery",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        88.76382446289062,
        260.8419189453125,
        101.95282745361328
      ],
      "text": "4.15\t Antibiotics for treatment of dysentery",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        105.38948059082031,
        399.13275146484375,
        118.87947845458984
      ],
      "text": "a)\t Children with diarrhoea and blood in stool (i.e. dysentery) should be treated with",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        118.38948059082031,
        399.05157470703125,
        131.87948608398438
      ],
      "text": "ciprofloxacin as a first line treatment. Ceftriaxone should be given as a second",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        131.3894805908203,
        399.1014404296875,
        144.87948608398438
      ],
      "text": "line treatment in severely ill children where local antimicrobial sensitivity is not",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        144.3894805908203,
        98.70149230957031,
        157.87948608398438
      ],
      "text": "known.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        157.3894805908203,
        289.5515441894531,
        170.87948608398438
      ],
      "text": "—\t Ciprofloxacin: 15 mg/kg/dose twice daily for 3 days",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        170.38938903808594,
        252.38157653808594,
        183.87939453125
      ],
      "text": "—\t Ceftriaxone: 50–80 mg/kg daily for 3 days",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        185.79409790039062,
        252.91282653808594,
        199.714111328125
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        202.05870056152344,
        396.7628479003906,
        215.5487060546875
      ],
      "text": "b) Where local antimicrobial sensitivity is known, local guidelines should be followed.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        217.46340942382812,
        252.91282653808594,
        231.3834228515625
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        62.36220169067383,
        249.94491577148438,
        333.8752746582031,
        263.1339111328125
      ],
      "text": "Recommendations for treatment of common causes of fever",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        274.28350830078125,
        334.7840881347656,
        287.4725036621094
      ],
      "text": "4.16\t Antibiotics for treatment of acute bacterial meningitis",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        290.9090881347656,
        399.1026306152344,
        304.39910888671875
      ],
      "text": "a)\t Children with acute bacterial meningitis should be treated empirically with 3rd",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        303.9090881347656,
        177.3615264892578,
        317.39910888671875
      ],
      "text": "generation cephalosporins.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        316.9090881347656,
        396.5814514160156,
        330.39910888671875
      ],
      "text": "—\t Ceftriaxone: 50mg/kg per dose IV every 12 hours or 100 mg/kg once daily, or",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        329.9090881347656,
        327.8315124511719,
        343.39910888671875
      ],
      "text": "—\t Cefotaxime: 50mg/kg per dose every 6 hours for 10–14 days.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        345.31378173828125,
        287.83294677734375,
        359.2337951660156
      ],
      "text": "(Strong recommendation, moderate quality of evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        361.5783996582031,
        399.0528869628906,
        375.06842041015625
      ],
      "text": "b)\tWhere it is known that there is no significant resistance to chloramphenicol",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        374.5783996582031,
        399.1015625,
        388.06842041015625
      ],
      "text": "and beta lactam antibiotics among bacteria-causing meningitis follow national",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        387.5783996582031,
        293.25152587890625,
        401.06842041015625
      ],
      "text": "guidelines or choose any of the following two regimens:",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        400.5783996582031,
        396.7713928222656,
        414.06842041015625
      ],
      "text": "—\t Chloramphenicol: 25 mg/kg IM (or IV) every 6 hours plus ampicillin: 50 mg/",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        82.20469665527344,
        413.5783996582031,
        193.87474060058594,
        427.06842041015625
      ],
      "text": "kg IM (or IV) every 6 hours",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        426.578369140625,
        81.58150482177734,
        440.0683898925781
      ],
      "text": "OR",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        439.578369140625,
        399.1313781738281,
        453.0683898925781
      ],
      "text": "—\t Chloramphenicol: 25 mg/kg IM (or IV) every 6 hours plus benzyl penicillin: 60",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        82.20469665527344,
        452.578369140625,
        291.3346862792969,
        466.0683898925781
      ],
      "text": "mg/kg (100 000 units/kg) every 6 hours IM (or IV).",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        467.98309326171875,
        301.0027770996094,
        481.9031066894531
      ],
      "text": "(Conditional recommendation, moderate quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        494.7953186035156,
        297.6920166015625,
        507.98431396484375
      ],
      "text": "4.17\t Antibiotics for treatment of acute otitis media",
      "font": "Helvetica-Condensed-Bold",
      "size": 11.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        511.4208984375,
        396.772705078125,
        524.910888671875
      ],
      "text": "a)\t Children with acute otitis media should be treated with oral amoxicillin at 40 mg/",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        524.4208984375,
        174.66151428222656,
        537.910888671875
      ],
      "text": "kg twice per for 7–10 days.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        539.8256225585938,
        252.91282653808594,
        553.74560546875
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        56.692901611328125,
        556.0902709960938,
        396.7728576660156,
        569.5802612304688
      ],
      "text": "b)\tWhere pathogens causing acute otitis media are known to be sensitive to co-",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        569.0902099609375,
        399.13128662109375,
        582.5802001953125
      ],
      "text": "trimoxazole, this antibiotic could be used as an alternative given twice per day for",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        68.03150177001953,
        582.0902099609375,
        109.18151092529297,
        595.5802001953125
      ],
      "text": "7–10 days.",
      "font": "MinionPro-Regular",
      "size": 10.0,
      "type": "paragraph"
    },
    {
      "bbox": [
        56.692901611328125,
        597.494873046875,
        252.91282653808594,
        611.4148559570312
      ],
      "text": "(Strong recommendation, low quality evidence)",
      "font": "MinionPro-BoldIt",
      "size": 10.0,
      "type": "heading"
    },
    {
      "bbox": [
        223.66839599609375,
        644.9403076171875,
        231.37240600585938,
        655.2992553710938
      ],
      "text": "17",
      "font": "Helvetica-Condensed-Ligh",
      "size": 9.0,
      "type": "paragraph"
    }
  ]
}